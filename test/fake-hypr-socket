#!/usr/bin/env python3
# TEST ONLY. Serves Hyprland's `j/cursorpos`, `j/monitors` and `j/clients` IPC
# requests on a Unix socket, moving the cursor along a slow diagonal over one
# terminal window so the tracker has something to log.
import json
import os
import socket
import sys
import time

path = sys.argv[1]
if os.path.exists(path):
    os.unlink(path)
srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
srv.bind(path)
srv.listen(8)
t0 = time.time()
while True:
    conn, _ = srv.accept()
    with conn:
        req = conn.recv(64)
        if req == b"j/cursorpos":
            t = time.time() - t0
            conn.sendall(json.dumps({"x": int(40 + 60 * t), "y": int(30 + 40 * t)}).encode())
        elif req == b"j/monitors":
            conn.sendall(json.dumps([{"activeWorkspace": {"id": 1}, "specialWorkspace": {"id": 0}}]).encode())
        elif req == b"j/clients":
            conn.sendall(json.dumps([
                {"at": [10, 10], "size": [300, 220], "class": "Alacritty", "workspace": {"id": 1},
                 "mapped": True, "hidden": False, "floating": False, "focusHistoryID": 0},
                {"at": [0, 0], "size": [320, 240], "class": "hidden-app", "workspace": {"id": 2},
                 "mapped": True, "hidden": False, "floating": False, "focusHistoryID": 1},
            ]).encode())
