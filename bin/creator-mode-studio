#!/usr/bin/env python3
"""creator-mode-studio: turn a Creator Mode recording into a polished "studio" cut.

    creator-mode-studio render VIDEO [options]

What it does (all local, ffmpeg + Python standard library only):
  * auto-zoom: eases in on clicks, typing bursts, or where the cursor comes to
    rest when clicks weren't readable; pans only when the cursor leaves a
    dead zone; eases back out
  * smooth cursor: redraws the cursor from the logged path with jitter
    removal and spring smoothing, fades it out while idle, squishes it on
    clicks and draws an expanding click ring
  * motion blur on fast cursor moves (and, with --camera-blur, fast camera moves)
  * a padded background (Omarchy theme, blurred wallpaper, presets, colors or
    an image) with rounded corners, an optional inset border and a soft shadow
  * export presets: source, 16:9, 9:16, 1:1, 4:5; MP4 or GIF; preview quality;
    VAAPI hardware encoding when the GPU supports it

Cursor/click data comes from the events file written by creator-mode-track
(default: <video dir>/.creator-mode/<video name>.events.jsonl). Without it the
video is only framed (no zoom, no redrawn cursor).

With --json-progress every stdout line is a JSON object:
  {"progress":0.42}  ...  {"ok":true,"file":"...","duration":12.3}
Failures print {"ok":false,"error":...,"message":...} and exit non-zero.
"""

import argparse
import glob
import json
import math
import os
import re
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import zlib

PRESETS = {
    "midnight": ("#312e81", "#0b1020"),
    "sunset": ("#fb923c", "#be185d"),
    "ocean": ("#38bdf8", "#4338ca"),
    "forest": ("#34d399", "#064e3b"),
    "aurora": ("#22d3ee", "#7c3aed"),
    "candy": ("#f9a8d4", "#8b5cf6"),
    "peach": ("#fed7aa", "#f43f5e"),
    "dusk": ("#a78bfa", "#1e1b4b"),
    "lime": ("#d9f99d", "#0f766e"),
    "slate": ("#94a3b8", "#0f172a"),
    "mono": ("#3f3f46", "#09090b"),
}
FORMATS = {"16:9": (16, 9), "9:16": (9, 16), "1:1": (1, 1), "4:5": (4, 5)}
CORNERS = ("br", "bl", "tr", "tl")
THEME_COLORS = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")
WALLPAPER = os.path.expanduser("~/.local/state/omarchy/current/background")

# Automatic zoom timing, in seconds.
ZOOM_LEAD = 0.45       # start easing in this long before a click
ZOOM_HOLD = 1.8        # stay zoomed this long after the last click
ZOOM_IN = 0.75         # ease-in duration
ZOOM_OUT = 0.95        # ease-out duration
KEY_HOLD = 1.4         # typing keeps a zoom alive this long after the last key
TYPE_GAP = 1.0         # keys closer than this are one typing burst
TYPE_MIN = 3           # keys in a burst before it counts as typing
MERGE_GAP = 2.5        # focus points closer than hold + this share one zoom (pan instead of out-and-in)
DWELL_MOVE = 80        # logical px the cursor must travel before a rest counts
DWELL_STILL = 6        # logical px of jitter allowed while resting
DWELL_TIME = 0.45      # rest this long to count as a focus point
DEADZONE = 0.35        # while zoomed, pan only once the cursor leaves the inner (1 - this) of the view
PAN_STIFFNESS = 14.0   # camera pan spring (critically damped)

# Cursor.
JITTER = 1.5           # logical px of movement ignored as sensor noise
IDLE_FADE_OUT = 0.35
IDLE_FADE_IN = 0.12
PRESS_DOWN = 0.06      # click squish: time to press down
PRESS_UP = 0.18        # and to spring back
PRESS_SCALE = 0.82
RING_TIME = 0.45
ZOOM_CURSOR = 0.6       # the cursor grows by zoom ** this, so it stays in proportion when zoomed
CURSOR_GROW_MAX = 1.6
LEVEL_STEP = 1.05       # size ratio between rows of the cursor sprite sheet
TEXT_APPS = {"alacritty", "kitty", "foot", "footclient", "com.mitchellh.ghostty", "ghostty",
             "org.wezfurlong.wezterm", "wezterm", "xterm", "konsole", "org.gnome.console",
             "org.gnome.terminal", "gnome-terminal-server", "st", "st-256color", "urxvt"}
FRAME_GUTTER = 0.012    # a blank run this wide (share of the zoomed view) marks where content starts
FRAME_MARGIN = 0.03     # breathing room left of content when a zoom is nudged to show it
ALPHAS = 11            # alpha levels in the cursor sprite sheet (0, 0.1, ... 1)
RING_FRAMES = 9
BLUR_START = 9.0       # cursor speed (logical px per 60 Hz frame) where the blur trail starts
BLUR_FULL = 26.0       # and where it is strongest
CAMERA_BLUR_SPEED = 3.5  # camera speed (output px per frame at 1080p) that turns on motion blur

JSON_MODE = False
OFF = -10000


class RenderError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def emit(obj):
    if JSON_MODE:
        print(json.dumps(obj), flush=True)


def log(msg):
    if not JSON_MODE:
        print(msg, file=sys.stderr, flush=True)


def clamp(v, lo, hi):
    return lo if v < lo else hi if v > hi else v


def ease_in_out(p):
    p = clamp(p, 0.0, 1.0)
    return 4 * p * p * p if p < 0.5 else 1 - (-2 * p + 2) ** 3 / 2


def ease_out(p):
    p = clamp(p, 0.0, 1.0)
    return 1 - (1 - p) ** 3


def even(v):
    return max(2, int(round(v)) // 2 * 2)


# ------------------------------------------------------------------ probing

def probe(video):
    try:
        raw = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries",
             "stream=codec_type,width,height,r_frame_rate:format=duration", "-of", "json", video],
            check=True, capture_output=True, text=True).stdout
        info = json.loads(raw)
    except (OSError, subprocess.CalledProcessError, ValueError) as e:
        raise RenderError("probe_failed", f"Can't read {video} with ffprobe: {e}") from e
    streams = info.get("streams", [])
    vs = next((s for s in streams if s.get("codec_type") == "video"), None)
    if not vs:
        raise RenderError("probe_failed", f"No video stream in {video}")
    num, _, den = vs.get("r_frame_rate", "60/1").partition("/")
    fps = float(num) / float(den or 1) if float(den or 1) else 60.0
    if not 1 <= fps <= 240:
        fps = 60.0
    duration = float(info.get("format", {}).get("duration") or 0)
    if duration <= 0:
        raise RenderError("probe_failed", f"{video} has no duration")
    return {
        "w": int(vs["width"]), "h": int(vs["height"]), "fps": fps, "duration": duration,
        "audio": any(s.get("codec_type") == "audio" for s in streams),
        "audio_tracks": sum(1 for s in streams if s.get("codec_type") == "audio"),
    }


def ffmpeg_version():
    try:
        out = subprocess.run(["ffmpeg", "-hide_banner", "-version"], capture_output=True, text=True).stdout
    except OSError:
        raise RenderError("missing_dependency", "Missing: ffmpeg. Install with: sudo pacman -S ffmpeg") from None
    m = re.search(r"ffmpeg version n?(\d+)\.(\d+)", out)
    return (int(m.group(1)), int(m.group(2))) if m else (99, 0)


def ffmpeg_script_flag():
    return "-filter_complex_script" if ffmpeg_version() < (7, 1) else "-/filter_complex"


def vaapi_device():
    dev = os.environ.get("CREATOR_MODE_VAAPI_DEVICE")
    if dev:
        return dev if os.path.exists(dev) else None
    nodes = sorted(glob.glob("/dev/dri/renderD*"))
    return nodes[0] if nodes else None


def vaapi_works(dev):
    """A tiny real encode: listing h264_vaapi says nothing about the driver."""
    try:
        proc = subprocess.run(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-vaapi_device", dev,
             "-f", "lavfi", "-i", "color=black:s=256x256:r=30:d=0.2",
             "-vf", "format=nv12,hwupload", "-c:v", "h264_vaapi", "-f", "null", "-"],
            capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


# ------------------------------------------------------------------ events

def default_events_path(video):
    d, name = os.path.split(os.path.abspath(video))
    return os.path.join(d, ".creator-mode", os.path.splitext(name)[0] + ".events.jsonl")


def sidecar(video, suffix):
    d, name = os.path.split(os.path.abspath(video))
    return os.path.join(d, ".creator-mode", os.path.splitext(name)[0] + suffix)


def load_json(path, what):
    try:
        with open(path) as f:
            data = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        raise RenderError("bad_" + what, f"Can't read {path}: {e}") from e
    return data if isinstance(data, dict) else None


def num(v, lo, hi, default):
    try:
        v = float(v)
    except (TypeError, ValueError):
        return default
    return default if math.isnan(v) else clamp(v, lo, hi)


def clean_edits(edits, duration):
    """Validated copy of an edit file: every time is clamped into the video."""
    edits = edits if isinstance(edits, dict) else {}

    def span(item):
        if isinstance(item, dict):
            a, b = item.get("start"), item.get("end")
        elif isinstance(item, (list, tuple)) and len(item) == 2:
            a, b = item
        else:
            return None
        a, b = num(a, 0, duration, None), num(b, 0, duration, None)
        return (a, b) if a is not None and b is not None and b - a >= 0.05 else None

    out = {"version": 1}
    trim = span(edits.get("trim"))
    out["trim"] = list(trim) if trim else [0.0, duration]
    out["cuts"] = sorted(list(c) for c in map(span, edits.get("cuts") or []) if c)
    out["speed"] = []
    for item in edits.get("speed") or []:
        sp = span(item)
        if sp and isinstance(item, dict):
            out["speed"].append({"start": sp[0], "end": sp[1], "rate": num(item.get("rate"), 0.25, 8.0, 1.0)})
    out["speed"].sort(key=lambda x: x["start"])
    zooms = edits.get("zooms")
    if isinstance(zooms, list):
        out["zooms"] = []
        for item in zooms:
            sp = span(item)
            if sp and isinstance(item, dict):
                out["zooms"].append({"start": sp[0], "end": sp[1], "zoom": num(item.get("zoom"), 1.0, 4.0, 1.8),
                                     "x": num(item.get("x"), 0, 1, 0.5), "y": num(item.get("y"), 0, 1, 0.5),
                                     "follow": bool(item.get("follow", True))})
        out["zooms"].sort(key=lambda z: z["start"])
    else:
        out["zooms"] = None
    audio = edits.get("audio") if isinstance(edits.get("audio"), dict) else {}
    out["audio"] = {"system": num(audio.get("system"), 0, 3, 1.0), "mic": num(audio.get("mic"), 0, 3, 1.0),
                    "denoise": bool(audio.get("denoise", False))}
    cam = edits.get("webcam") if isinstance(edits.get("webcam"), dict) else {}
    corner = cam.get("corner") if cam.get("corner") in CORNERS else "br"
    out["webcam"] = {"enabled": bool(cam.get("enabled", True)), "corner": corner,
                     "size": num(cam.get("size"), 0.1, 0.45, 0.24), "mirror": bool(cam.get("mirror", True))}
    if isinstance(edits.get("render"), dict):
        out["render"] = {k: v for k, v in edits["render"].items() if isinstance(v, (str, int, float, bool))}
    return out


def timeline_pieces(edits, duration):
    """Kept source ranges with playback rates, [(start, end, rate)], after trim, cuts and speed-ups."""
    ranges = [tuple(edits["trim"])]
    for a, b in edits["cuts"]:
        nxt = []
        for s0, e0 in ranges:
            if b <= s0 or a >= e0:
                nxt.append((s0, e0))
                continue
            if a > s0:
                nxt.append((s0, a))
            if b < e0:
                nxt.append((b, e0))
        ranges = nxt
    pieces = []
    for s0, e0 in ranges:
        cur = s0
        for sp in edits["speed"]:
            a, b = max(sp["start"], cur), min(sp["end"], e0)
            if b <= a:
                continue
            if a > cur:
                pieces.append((cur, a, 1.0))
            pieces.append((a, b, sp["rate"]))
            cur = b
        if cur < e0:
            pieces.append((cur, e0, 1.0))
    pieces = [p for p in pieces if p[1] - p[0] >= 0.05]
    if not pieces:
        raise RenderError("usage", "The edits remove the whole recording")
    return pieces


def atempo(rate):
    parts = []
    while rate > 2.0:
        parts.append("atempo=2")
        rate /= 2.0
    while rate < 0.5:
        parts.append("atempo=0.5")
        rate /= 0.5
    if abs(rate - 1.0) > 1e-3:
        parts.append(f"atempo={rate:.4f}")
    return ",".join(parts) or "anull"


def load_events(path):
    meta, moves, clicks, keys, end = None, [], [], [], None
    with open(path) as f:
        for line in f:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind = ev.get("type")
            if kind == "meta":
                meta = ev
            elif kind == "click":
                clicks.append(float(ev["t"]))
            elif kind == "key":
                keys.append(float(ev["t"]))
            elif kind == "end":
                end = float(ev["t"])
            elif "x" in ev and "y" in ev:
                moves.append((float(ev["t"]), float(ev["x"]), float(ev["y"])))
    if not meta or "region" not in meta:
        raise RenderError("bad_events", f"{path} has no header line")
    moves.sort()
    return meta, moves, sorted(clicks), sorted(keys), end


def load_windows(path):
    """[(t, [[x, y, w, h, class], ...]), ...]: visible windows, topmost first."""
    out = []
    with open(path) as f:
        for line in f:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if isinstance(ev, dict) and ev.get("type") == "windows" and isinstance(ev.get("w"), list):
                wins = [w_ for w_ in ev["w"] if isinstance(w_, list) and len(w_) == 5]
                out.append((float(ev["t"]), wins))
    out.sort(key=lambda e: e[0])
    return out


def cursor_shapes(cursor, windows, fps, offset, map_xy):
    """Per frame: "ibeam" over a terminal window, "arrow" elsewhere."""
    shapes = ["arrow"] * len(cursor)
    if not windows:
        return shapes
    rects = [(t, [(*map_xy(x, y), *map_xy(x + ww, y + wh), str(c).lower()) for x, y, ww, wh, c in wins])
             for t, wins in windows]
    i = -1
    for n, pos in enumerate(cursor):
        t = n / fps + offset
        while i + 1 < len(rects) and rects[i + 1][0] <= t:
            i += 1
        if pos is None or i < 0:
            continue
        for x0, y0, x1, y1, cls in rects[i][1]:
            if x0 <= pos[0] < x1 and y0 <= pos[1] < y1:
                if cls in TEXT_APPS:
                    shapes[n] = "ibeam"
                break
    return shapes


def _num(v):
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else None


def capture_offset(meta, session, end, duration):
    """Tracker time of the video's first frame. The controller notes when the
    recorder first wrote to the file; recorders drop a variable tail on stop,
    so the tracker's end mark is only a fallback."""
    rec, start = _num(session.get("recStart")), _num(meta.get("start"))
    if rec is not None and start is not None and 0 <= rec - start < 30:
        return rec - start
    return (end - duration) if end is not None else 0.0


def webcam_lead(session, cam_duration, duration):
    """Seconds of webcam footage before the screen recording's first frame."""
    rec, cam = _num(session.get("recStart")), _num(session.get("webcamStart"))
    if rec is not None and cam is not None and 0 <= rec - cam < 30:
        return rec - cam
    return cam_duration - duration


# ------------------------------------------------------------------ motion

class Spring:
    """Semi-implicit damped spring; ratio 1.0 is critically damped."""

    def __init__(self, value, stiffness, ratio=1.0):
        self.value = value
        self.velocity = 0.0
        self.k = stiffness
        self.c = 2.0 * math.sqrt(stiffness) * ratio

    def step(self, target, dt):
        # sub-step so stiff springs stay stable at low frame rates
        n = max(1, int(math.ceil(dt * math.sqrt(self.k) / 0.25)))
        h = dt / n
        for _ in range(n):
            accel = self.k * (target - self.value) - self.c * self.velocity
            self.velocity += accel * h
            self.value += self.velocity * h
        return self.value


def sample_cursor(moves, n_frames, fps, offset, map_xy):
    """Cursor position (work px, or None before the first sample) at each frame.
    The tracker logs only changes, so short gaps are interpolated and long gaps hold."""
    out = [None] * n_frames
    i = 0
    for n in range(n_frames):
        t = n / fps + offset
        if not moves or moves[0][0] > t:
            continue
        while i + 1 < len(moves) and moves[i + 1][0] <= t:
            i += 1
        t0, x0, y0 = moves[i]
        if i + 1 < len(moves) and 0 < moves[i + 1][0] - t0 < 0.1:
            t1, x1, y1 = moves[i + 1]
            a = (t - t0) / (t1 - t0)
            x0, y0 = x0 + (x1 - x0) * a, y0 + (y1 - y0) * a
        out[n] = map_xy(x0, y0)
    return out


SMOOTH_RATE = 240.0     # Hz of the dense path the cursor is smoothed on
TRACKER_STEP = 1 / 60.0  # the tracker's polling interval


def smooth_cursor(moves, n_frames, fps, offset, map_xy, smoothing, jitter):
    """Smoothed cursor position (work px, or None before the first sample) at each frame.

    The logged samples (changes only, polled at ~60 Hz) become a dense path that
    rests until just before each move, with sensor jitter held still. That path
    is run through a critically damped spring forwards and then backwards, which
    rounds off steps and corners without the lag of a one-way filter."""
    out = [None] * n_frames
    if not moves:
        return out
    keys, held = [], None
    for t, x, y in moves:
        if held is None or math.hypot(x - held[0], y - held[1]) > jitter:
            held = (x, y)
        if keys and t - keys[-1][0] > 2 * TRACKER_STEP:
            keys.append((max(keys[-1][0], t - TRACKER_STEP), keys[-1][1], keys[-1][2]))
        keys.append((t, held[0], held[1]))
    t_first = keys[0][0]
    t0 = max(offset, t_first)
    t_end = offset + n_frames / fps
    if t0 >= t_end:
        return out
    dt = 1.0 / SMOOTH_RATE
    count = int(math.ceil((t_end - t0) / dt)) + 1
    xs, ys = [0.0] * count, [0.0] * count
    i = 0
    for k in range(count):
        t = t0 + k * dt
        while i + 1 < len(keys) and keys[i + 1][0] <= t:
            i += 1
        ta, xa, ya = keys[i]
        if i + 1 < len(keys) and keys[i + 1][0] > ta:
            tb, xb, yb = keys[i + 1]
            a = clamp((t - ta) / (tb - ta), 0.0, 1.0)
            xa, ya = xa + (xb - xa) * a, ya + (yb - ya) * a
        xs[k], ys[k] = map_xy(xa, ya)
    smoothing = clamp(smoothing, 0.0, 1.0)
    if smoothing > 0:
        stiffness = 1400.0 * (1 - smoothing) + 90.0 * smoothing
        for series in (xs, ys):
            for order in (range(count), range(count - 1, -1, -1)):
                sp = None
                for k in order:
                    if sp is None:
                        sp = Spring(series[k], stiffness)
                    series[k] = sp.step(series[k], dt)
    for n in range(n_frames):
        t = n / fps + offset
        if t < t_first:
            continue
        k = int(round((t - t0) / dt))
        if 0 <= k < count:
            out[n] = (xs[k], ys[k])
    return out


def dwell_points(cursor, fps, scale):
    """Times where the cursor comes to rest after travelling (click stand-in)."""
    points, anchor, still_since, travelled, last_point = [], None, None, 0.0, -1e9
    move_px, still_px, still_frames = DWELL_MOVE * scale, DWELL_STILL * scale, int(DWELL_TIME * fps)
    prev = None
    for n, pos in enumerate(cursor):
        if pos is None:
            continue
        if prev is not None:
            travelled += math.hypot(pos[0] - prev[0], pos[1] - prev[1])
        prev = pos
        if anchor is None or math.hypot(pos[0] - anchor[0], pos[1] - anchor[1]) > still_px:
            anchor, still_since = pos, n
            continue
        if n - still_since == still_frames and travelled >= move_px and (n - last_point) / fps > 1.5:
            points.append(still_since / fps)
            last_point = n
            travelled = 0.0
    return points


def typing_bursts(key_times):
    bursts, cur = [], []
    for k in key_times:
        if cur and k - cur[-1] > TYPE_GAP:
            if len(cur) >= TYPE_MIN:
                bursts.append((cur[0], cur[-1]))
            cur = []
        cur.append(k)
    if len(cur) >= TYPE_MIN:
        bursts.append((cur[0], cur[-1]))
    return bursts


def position_at(cursor, t, fps):
    n = clamp(int(round(t * fps)), 0, len(cursor) - 1)
    for m in range(n, -1, -1):
        if cursor[m] is not None:
            return cursor[m]
    return next((p for p in cursor[n:] if p is not None), None)


def explicit_focus(zoom, clicks, cursor, fps, w, h):
    """Focus points for a zoom set in the editor: its anchor, then every click
    inside it when it follows the cursor."""
    focus = [(zoom["start"], zoom["x"] * w, zoom["y"] * h)]
    if zoom["follow"]:
        for t in clicks:
            p = position_at(cursor, t, fps) if zoom["start"] < t < zoom["end"] else None
            if p is not None:
                focus.append((t, p[0], p[1]))
    return focus


def cursor_track_json(cursor, fps, w, h, rate=10):
    """Cursor positions as [t, x, y] (0..1) at a coarse rate, for the editor."""
    step = max(1, int(round(fps / rate)))
    return [[round(n / fps, 2), round(p[0] / w, 4), round(p[1] / h, 4)]
            for n, p in ((n, cursor[n]) for n in range(0, len(cursor), step)) if p is not None]


def zoom_segments(focus_times, key_times, duration, cursor, fps, zoom):
    """Zoom segments: {"start", "end", "zoom", "focus": [(t, x, y), ...]}.

    A focus point is a click (or a cursor rest); typing extends the zoom it
    happens in, and a typing burst outside any zoom starts one on the last
    click, so the camera stays on the text field being typed into."""
    points = []
    for t in focus_times:
        p = position_at(cursor, t, fps)
        if p is not None:
            points.append((t, p[0], p[1], t + ZOOM_HOLD))
    for start, stop in typing_bursts(key_times):
        if any(t - ZOOM_LEAD <= start <= hold + MERGE_GAP for t, _, _, hold in points):
            continue
        prior = [pt for pt in points if pt[0] <= start and start - pt[0] < 15]
        p = prior[-1][1:3] if prior else position_at(cursor, start, fps)
        if p is not None:
            points.append((start, p[0], p[1], stop + KEY_HOLD))
    points.sort()
    segs = []
    for t, x, y, hold in points:
        start = max(0.0, t - ZOOM_LEAD)
        if segs and start <= segs[-1]["end"] + MERGE_GAP:
            segs[-1]["end"] = max(segs[-1]["end"], hold)
            segs[-1]["focus"].append((t, x, y))
        else:
            segs.append({"start": start, "end": hold, "zoom": zoom, "focus": [(t, x, y)]})
    for k in key_times:
        for seg in segs:
            if seg["start"] <= k <= seg["end"]:
                seg["end"] = max(seg["end"], k + KEY_HOLD)
    out = []
    for seg in segs:
        seg["end"] = min(seg["end"], duration)
        if out and seg["start"] <= out[-1]["end"]:
            out[-1]["end"] = max(out[-1]["end"], seg["end"])
            out[-1]["focus"] += seg["focus"]
        elif seg["end"] > seg["start"]:
            out.append(seg)
    return out


def thumbnail(video, t, gw, gh):
    """Grayscale gw x gh frame at t, or None."""
    try:
        r = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{max(0.0, t):.3f}", "-i", video, "-frames:v", "1",
                            "-vf", f"scale={gw}:{gh},format=gray", "-f", "rawvideo", "-"],
                           capture_output=True, timeout=20, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if len(r.stdout) == gw * gh else None


def frame_center_x(gray, gw, gh, fx, fy, hw, hh, w, h):
    """Center x for a zoom on (fx, fy) whose half view is hw x hh (work px).
    If centring on the point would cut through content on the left (the start
    of lines of text), move the view left to just before that content, as long
    as the point stays comfortably in view."""
    kx, ky = gw / w, gh / h
    left = clamp(fx - hw, 0.0, w - 2 * hw)
    if left <= 0:
        return fx
    y0, y1 = int(clamp((fy - hh) * ky, 0, gh - 1)), int(clamp((fy + hh) * ky, 1, gh))
    band = [gray[y * gw:(y + 1) * gw] for y in range(y0, y1)]
    sample = sorted(row[x] for row in band[::4] for x in range(0, gw, 4))
    if not sample:
        return fx
    bg = sample[len(sample) // 2]
    need = max(3, int((y1 - y0) * 0.06))

    def ink(col):
        return sum(1 for row in band if abs(row[col] - bg) > 28) >= need

    c = int(left * kx)
    if not any(ink(x) for x in range(max(0, c - 1), min(gw, c + 2))):
        return fx
    lo = int(max(0.0, fx - 2 * hw * 0.85) * kx)
    gutter = max(3, int(2 * hw * kx * FRAME_GUTTER))
    # the furthest-left content start in reach, so columns inside a table
    # don't count as the start of the lines
    run, start = 0, None
    for col in range(c, lo - 1, -1):
        run = run + 1 if not ink(col) else 0
        if run == gutter or (col == 0 and 0 < run < gutter):
            start = col + run
    if start is None or start > c:
        return fx
    new_left = max(start / kx - 2 * hw * FRAME_MARGIN, fx - 2 * hw * 0.85, 0.0)
    return new_left + hw


def frame_segments(video, segments, w, h, view, explicit):
    """Nudge each zoom's focus points so the zoomed view doesn't cut off the
    start of text. An editor zoom's own anchor is left where the user put it."""
    gw = 480
    gh = max(2, int(round(gw * h / w)))
    budget = 120
    for seg in segments:
        hw, hh = view[0] / (2 * seg["zoom"]), view[1] / (2 * seg["zoom"])
        for i, (t, fx, fy) in enumerate(seg["focus"]):
            if (explicit and i == 0) or budget <= 0:
                continue
            budget -= 1
            gray = thumbnail(video, t, gw, gh)
            if gray is not None:
                seg["focus"][i] = (t, frame_center_x(gray, gw, gh, fx, fy, hw, hh, w, h), fy)
    return segments


def zoom_amount(t, seg):
    """0..1: how far into seg's zoom the camera is at time t."""
    rise = ease_in_out((t - seg["start"]) / ZOOM_IN)
    fall = 1 - ease_in_out((t - seg["end"]) / ZOOM_OUT)
    return min(rise, fall)


def camera_path(cursor, n_frames, fps, w, h, view, segments, fill):
    """Per-frame viewport (left, top, width, height) in work px.

    view = (vw0, vh0): the viewport at zoom 1 (the whole frame, or a slice of
    it when the output aspect differs and --layout fill is used)."""
    dt = 1.0 / fps
    vw0, vh0 = view
    mid = (w / 2, h / 2)
    base_x, base_y = Spring(mid[0], 6.0), Spring(mid[1], 6.0)
    base_target = list(mid)
    # the pan target goes through a stiffer spring first, so pans ease in as
    # well as out instead of setting off at full speed
    pan_x, pan_y = Spring(mid[0], PAN_STIFFNESS), Spring(mid[1], PAN_STIFFNESS)
    aim_x, aim_y = Spring(mid[0], PAN_STIFFNESS * 3), Spring(mid[1], PAN_STIFFNESS * 3)
    target = mid
    seg_i, entered = 0, -1
    out = []
    for n in range(n_frames):
        t = n * dt
        pos = cursor[n]
        # the base viewport (zoom 1) follows the cursor when it is narrower than the frame
        if fill and pos is not None:
            for axis, size, full in ((0, vw0, w), (1, vh0, h)):
                if size < full - 1 and abs(pos[axis] - base_target[axis]) > size / 2 * 0.5:
                    base_target[axis] = pos[axis]
        bx, by = base_x.step(base_target[0], dt), base_y.step(base_target[1], dt)

        while seg_i + 1 < len(segments) and t >= segments[seg_i + 1]["start"]:
            seg_i += 1
        seg = segments[seg_i] if segments else None
        amount = zoom_amount(t, seg) if seg and t >= seg["start"] else 0.0
        z = 1.0 + (seg["zoom"] - 1.0) * amount if seg else 1.0
        if seg and seg["start"] <= t <= seg["end"]:
            if entered != seg_i:
                entered = seg_i
                target = seg["focus"][0][1:3]
                for sp, v in ((pan_x, target[0]), (pan_y, target[1]), (aim_x, target[0]), (aim_y, target[1])):
                    sp.value, sp.velocity = v, 0.0
            hw, hh = vw0 / (2 * seg["zoom"]), vh0 / (2 * seg["zoom"])
            for ft, fx, fy in seg["focus"]:
                if 0 <= t - ft < dt and (abs(fx - target[0]) > hw * (1 - DEADZONE) or abs(fy - target[1]) > hh * (1 - DEADZONE)):
                    target = (fx, fy)
            if seg.get("follow", True) and pos is not None and (abs(pos[0] - target[0]) > hw * (1 - DEADZONE) or abs(pos[1] - target[1]) > hh * (1 - DEADZONE)):
                target = (target[0] + (pos[0] - target[0]) * 0.85, target[1] + (pos[1] - target[1]) * 0.85)
        px, py = pan_x.step(aim_x.step(target[0], dt), dt), pan_y.step(aim_y.step(target[1], dt), dt)
        # blend from the base view to the pan target as the zoom comes in, so
        # zooming reads as one move toward the point rather than zoom-then-pan
        s = (z - 1.0) / (seg["zoom"] - 1.0) if seg and seg["zoom"] > 1.0 else 0.0
        cx, cy = bx + (px - bx) * s, by + (py - by) * s
        vw, vh = vw0 / z, vh0 / z
        cx = clamp(cx, vw / 2, w - vw / 2)
        cy = clamp(cy, vh / 2, h - vh / 2)
        out.append((cx - vw / 2, cy - vh / 2, vw, vh))
    return out


def camera_keyframed(camera, step):
    """The viewport per frame as the renderer applies it: sampled every `step`
    frames and linearly interpolated (see piecewise_expr)."""
    n = len(camera)
    out = []
    for i in range(n):
        a = (i // step) * step
        b = min(a + step, n - 1)
        if b <= a:
            out.append(camera[a])
            continue
        f = (i - a) / (b - a)
        out.append(tuple(p + (q - p) * f for p, q in zip(camera[a], camera[b], strict=True)))
    return out


def to_output(states, camera, out_w, out_h):
    """Move sprite states from work px into the zoomed, scaled output video."""
    res = []
    for st, (left, top, vw, vh) in zip(states, camera, strict=True):
        if st is None:
            res.append(None)
            continue
        res.append((st[0], st[1], (st[2] - left) * out_w / vw, (st[3] - top) * out_h / vh))
    return res


def blur_windows(camera, fps, out_w, canvas_h):
    """Time ranges where the camera moves fast enough to deserve motion blur."""
    flags = []
    norm = 1080.0 / canvas_h * (fps / 60.0)
    for n in range(len(camera)):
        if n == 0:
            flags.append(False)
            continue
        (l0, t0, w0, h0), (l1, t1, w1, h1) = camera[n - 1], camera[n]
        k = out_w / w1
        move = max(abs(l1 - l0), abs(t1 - t0), abs(l1 + w1 - l0 - w0), abs(t1 + h1 - t0 - h0)) * k * norm
        flags.append(move > CAMERA_BLUR_SPEED)
    windows, start = [], None
    for n, f in enumerate(flags + [False]):
        if f and start is None:
            start = n
        elif not f and start is not None:
            if windows and start - windows[-1][1] <= 3:
                windows[-1] = (windows[-1][0], n)
            else:
                windows.append((start, n))
            start = None
    return [(max(0, a - 1) / fps, (b + 1) / fps) for a, b in windows if b - a >= 2]


def piecewise_expr(values, step):
    """ffmpeg expression over `in` (frame index) that linearly interpolates
    `values` sampled every `step` frames; zeros collapse into one branch. The
    expression is a balanced if-tree so evaluation stays O(log n) per frame."""
    n = len(values)
    leaves = []  # (start, end, text)
    for a in range(0, n, step):
        b = min(a + step, n - 1)
        va, vb = values[a], values[b]
        if abs(va) < 0.01 and abs(vb) < 0.01:
            text = "0"
        elif b == a or abs(vb - va) < 0.01:
            text = f"{va:.2f}"
        else:
            text = f"({va:.2f}+{(vb - va) / (b - a):.4f}*(in-{a}))"
        if leaves and leaves[-1][2] == text == "0":
            leaves[-1] = (leaves[-1][0], a + step, "0")
        else:
            leaves.append((a, a + step, text))

    def build(lo, hi):
        if hi - lo == 1:
            return leaves[lo][2]
        mid = (lo + hi) // 2
        return f"if(lt(in,{leaves[mid][0]}),{build(lo, mid)},{build(mid, hi)})"

    return build(0, len(leaves)) if leaves else "0"


# ------------------------------------------------------------------ images

def write_png(path, width, height, rgba):
    raw = b"".join(b"\x00" + bytes(rgba[y * width * 4:(y + 1) * width * 4]) for y in range(height))

    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 6)))
        f.write(chunk(b"IEND", b""))


def inside(poly, x, y):
    hit = False
    j = len(poly) - 1
    for i in range(len(poly)):
        xi, yi = poly[i]
        xj, yj = poly[j]
        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi:
            hit = not hit
        j = i
    return hit


# Arrow cursor in a 17x25 design grid; the hotspot is the tip at (0, 0).
ARROW_OUTER = [(0, 0), (0, 22.4), (5.4, 17.1), (9.0, 25.2), (12.9, 23.5), (9.4, 15.6), (16.6, 15.6)]
ARROW_INNER = [(1.6, 3.8), (1.6, 18.6), (5.9, 14.4), (9.8, 23.0), (11.0, 22.5), (7.1, 13.9), (12.9, 13.9)]


# text cursor (I-beam); its hotspot is the middle of the stem
IBEAM_OUTER = [(0.3, 0), (8.7, 0), (8.7, 4.0), (6.5, 4.0), (6.5, 18.0), (8.7, 18.0), (8.7, 22.0),
               (0.3, 22.0), (0.3, 18.0), (2.5, 18.0), (2.5, 4.0), (0.3, 4.0)]
IBEAM_INNER = [(1.5, 1.2), (7.5, 1.2), (7.5, 2.8), (5.3, 2.8), (5.3, 19.2), (7.5, 19.2), (7.5, 20.8),
               (1.5, 20.8), (1.5, 19.2), (3.7, 19.2), (3.7, 2.8), (1.5, 2.8)]
IBEAM_HOT = (4.5, 11.0)
SHAPES = {"arrow": (ARROW_OUTER, ARROW_INNER, (0.0, 0.0)), "ibeam": (IBEAM_OUTER, IBEAM_INNER, IBEAM_HOT)}


def cursor_tile(w, h, pad, unit, shape="arrow"):
    """RGBA (premultiplied-free) pixels of a cursor shape at `unit` px per design
    unit, drawn from (pad, pad): black body, white outline, soft drop shadow."""
    ss = 3
    poly_o, poly_i, _ = SHAPES[shape]
    outer = [(x * unit + pad, y * unit + pad) for x, y in poly_o]
    inner = [(x * unit + pad, y * unit + pad) for x, y in poly_i]
    cover_o = [0.0] * (w * h)
    cover_i = [0.0] * (w * h)
    x_max = max(x for x, _ in poly_o) * unit + pad + 1
    y_max = max(y for _, y in poly_o) * unit + pad + 1
    for py in range(h):
        if py > y_max:
            break
        for px in range(w):
            if px > x_max:
                break
            o = i = 0
            for sy in range(ss):
                for sx in range(ss):
                    x, y = px + (sx + 0.5) / ss, py + (sy + 0.5) / ss
                    if inside(outer, x, y):
                        o += 1
                        if inside(inner, x, y):
                            i += 1
            cover_o[py * w + px] = o / (ss * ss)
            cover_i[py * w + px] = i / (ss * ss)
    shift = max(1, int(round(1.2 * unit)))
    radius = max(1, int(round(1.6 * unit)))
    # separable box blur of the shifted outline coverage
    tmp = [0.0] * (w * h)
    for py in range(h):
        for px in range(w):
            acc = 0.0
            for dx in range(-radius, radius + 1):
                x = px - shift + dx
                if 0 <= x < w:
                    acc += cover_o[py * w + x]
            tmp[py * w + px] = acc
    shadow = [0.0] * (w * h)
    norm = (2 * radius + 1) ** 2
    for py in range(h):
        for px in range(w):
            acc = 0.0
            for dy in range(-radius, radius + 1):
                y = py - shift + dy
                if 0 <= y < h:
                    acc += tmp[y * w + px]
            shadow[py * w + px] = acc / norm * 0.45
    px_out = []
    for k in range(w * h):
        o, i, s = cover_o[k], cover_i[k], shadow[k]
        a = o + s * (1 - o)
        c = 255 * (o - i) / a if a > 0 else 0
        px_out.append((int(c), a))
    return px_out


def cursor_levels(grow_max):
    """Cursor sizes in the sprite sheet: LEVEL_STEP apart, from a full click
    squish up to the largest zoomed size, including 1.0 exactly."""
    lo = int(math.floor(math.log(PRESS_SCALE) / math.log(LEVEL_STEP)))
    hi = int(math.ceil(math.log(max(1.0, grow_max)) / math.log(LEVEL_STEP)))
    return [LEVEL_STEP ** k for k in range(lo, hi + 1)]


def make_cursor_sheet(path, size_px, levels, shapes=("arrow",)):
    """Sprite sheet: one row per (shape, size level), columns alpha levels.
    Returns (tile_w, tile_h, pad, rows) where rows[(shape, level_index)] is
    (row, dx, dy): the tile's hotspot sits at (pad + dx, pad + dy)."""
    unit = size_px / 25.2
    pad = max(2, int(round(3 * unit)))
    top = max(levels)
    tw = int(math.ceil(17 * unit * top)) + pad * 2 + 2
    th = int(math.ceil(25.5 * unit * top)) + pad * 2 + 2
    plan = [(shape, li, lv) for shape in shapes for li, lv in enumerate(levels)]
    sw, sh = tw * ALPHAS, th * len(plan)
    rgba = bytearray(sw * sh * 4)
    rows = {}
    for row, (shape, li, scale) in enumerate(plan):
        hx, hy = SHAPES[shape][2]
        rows[(shape, li)] = (row, hx * unit * scale, hy * unit * scale)
        tile = cursor_tile(tw, th, pad, unit * scale, shape)
        for col in range(ALPHAS):
            alpha = col / (ALPHAS - 1)
            for y in range(th):
                base = ((row * th + y) * sw + col * tw) * 4
                for x in range(tw):
                    c, a = tile[y * tw + x]
                    k = base + x * 4
                    rgba[k:k + 4] = bytes((c, c, c, int(round(a * alpha * 255))))
    write_png(path, sw, sh, rgba)
    return tw, th, pad, rows


def pick_tiles(states, zooms, shapes, levels, rows):
    """Turn (alpha_col, squish, x, y) states into (col, row, x, y) sprite
    states: the size row follows the click squish and the camera zoom."""
    logs = [math.log(lv) for lv in levels]
    out = []
    for n, st in enumerate(states):
        if st is None:
            out.append(None)
            continue
        size = st[1] * min(CURSOR_GROW_MAX, zooms[n] ** ZOOM_CURSOR)
        ls = math.log(size)
        li = min(range(len(levels)), key=lambda i: abs(logs[i] - ls))
        row, dx, dy = rows.get((shapes[n], li)) or rows[("arrow", li)]
        out.append((st[0], row, st[2] - dx, st[3] - dy))
    return out


def make_ring_sheet(path, radius_px, width_px):
    """RING_FRAMES tiles of an expanding, fading click ring."""
    size = int(math.ceil((radius_px + width_px) * 2)) + 4
    c = size / 2
    sw = size * RING_FRAMES
    rgba = bytearray(sw * size * 4)
    for f in range(RING_FRAMES):
        p = f / (RING_FRAMES - 1)
        r = radius_px * (0.35 + 0.65 * ease_out(p))
        lw = width_px * (1.3 - 0.5 * p)
        fade = (1 - p) ** 1.3
        for y in range(size):
            for x in range(size):
                d = math.hypot(x + 0.5 - c, y + 0.5 - c)
                ring = clamp(lw / 2 + 0.5 - abs(d - r), 0.0, 1.0)
                fill = clamp(r - d, 0.0, 1.0) * 0.22
                a = max(ring * 0.8, fill) * fade
                k = (y * sw + f * size + x) * 4
                rgba[k:k + 4] = bytes((255, 255, 255, int(a * 255)))
    write_png(path, sw, size, rgba)
    return size


def cursor_track(smooth, raw, clicks_f, fps, w, h, scale, hide_idle, blur):
    """Per-frame sprite states for the cursor, two blur ghosts and the ring:
    [(alpha_col, squish, x, y) or None, ...] per cursor layer, and
    [(ring_frame, 0, x, y) or None, ...] for the ring."""
    n_frames = len(smooth)
    alpha, last_move, anchor = 0.0, -1e9, None
    press_i = ring_i = 0
    main, g1, g2, ring = [], [], [], []
    last_click = None
    for n in range(n_frames):
        pos, rpos = smooth[n], raw[n]
        while press_i < len(clicks_f) and clicks_f[press_i] <= n:
            last_click = clicks_f[press_i]
            last_move = n
            press_i += 1
        if rpos is not None and (anchor is None or math.hypot(rpos[0] - anchor[0], rpos[1] - anchor[1]) > 3 * scale):
            anchor = rpos
            last_move = n
        visible = pos is not None and -2 <= pos[0] <= w + 2 and -2 <= pos[1] <= h + 2
        idle = (n - last_move) / fps
        want = 1.0 if visible and (hide_idle <= 0 or idle < hide_idle) else 0.0
        if n == 0:
            alpha = want
        elif want > alpha:
            alpha = min(want, alpha + 1.0 / (IDLE_FADE_IN * fps))
        else:
            alpha = max(want, alpha - 1.0 / (IDLE_FADE_OUT * fps))
        if not visible:
            alpha = 0.0
        squish = 1.0
        if last_click is not None:
            d = (n - last_click) / fps
            if d < PRESS_DOWN:
                squish = 1 - (1 - PRESS_SCALE) * ease_out(d / PRESS_DOWN)
            elif d < PRESS_DOWN + PRESS_UP:
                squish = PRESS_SCALE + (1 - PRESS_SCALE) * ease_out((d - PRESS_DOWN) / PRESS_UP)
        row = squish
        col = int(round(alpha * (ALPHAS - 1)))
        main.append((col, row, pos[0], pos[1]) if col > 0 and pos is not None else None)

        ghosts = [None, None]
        if blur and col > 0 and n > 0 and smooth[n - 1] is not None:
            prev = smooth[n - 1]
            speed = math.hypot(pos[0] - prev[0], pos[1] - prev[1]) / scale * (fps / 60.0)
            k = clamp((speed - BLUR_START) / (BLUR_FULL - BLUR_START), 0.0, 1.0)
            if k > 0:
                for gi, (frac, strength) in enumerate(((0.33, 0.55), (0.66, 0.3))):
                    gcol = int(round(alpha * strength * k * (ALPHAS - 1)))
                    if gcol > 0:
                        ghosts[gi] = (gcol, row, pos[0] - (pos[0] - prev[0]) * frac, pos[1] - (pos[1] - prev[1]) * frac)
        g1.append(ghosts[0])
        g2.append(ghosts[1])

        state = None
        while ring_i < len(clicks_f) and clicks_f[ring_i] <= n:
            ring_i += 1
        if ring_i:
            d = (n - clicks_f[ring_i - 1]) / fps
            frame = int(d / RING_TIME * (RING_FRAMES - 1))
            if 0 <= d < RING_TIME and frame < RING_FRAMES - 1:
                at = raw[clicks_f[ring_i - 1]] if clicks_f[ring_i - 1] < n_frames else None
                at = at or pos
                if at is not None:
                    state = (frame, 0, at[0], at[1])
        ring.append(state)
    return main, g1, g2, ring


def sprite_commands(layers, fps):
    """sendcmd scripts: one for the sprite crops (tile choice), one for the
    overlays (position). layers: [(name, states, tile_w, tile_h, anchor_x, anchor_y)]."""
    crop_lines, pos_lines = [], []
    n_frames = len(layers[0][1])
    last = {}
    for n in range(n_frames):
        crop_cmds, pos_cmds = [], []
        for name, states, tw, th, ax, ay in layers:
            st = states[n]
            if st is None:
                tile, xy = last.get(name, (None, None))[0], (OFF, OFF)
            else:
                tile, xy = (st[0] * tw, st[1] * th), (int(round(st[2] - ax)), int(round(st[3] - ay)))
            prev_tile, prev_xy = last.get(name, (None, None))
            if tile is not None and tile != prev_tile:
                crop_cmds += [f"crop@{name} x {tile[0]}", f"crop@{name} y {tile[1]}"]
            if xy != prev_xy:
                pos_cmds += [f"overlay@{name} x {xy[0]}", f"overlay@{name} y {xy[1]}"]
            last[name] = (tile if tile is not None else prev_tile, xy)
        ts = f"{n / fps:.4f}"
        if crop_cmds:
            crop_lines.append(ts + " " + ", ".join(crop_cmds) + ";")
        if pos_cmds:
            pos_lines.append(ts + " " + ", ".join(pos_cmds) + ";")
    return crop_lines, pos_lines


def theme_gradient():
    try:
        with open(THEME_COLORS) as f:
            text = f.read()
    except OSError:
        return None
    colors = dict(re.findall(r'^\s*(\w+)\s*=\s*"(#[0-9a-fA-F]{6})"', text, re.M))
    if "accent" not in colors:
        return None
    return colors["accent"], colors.get("darker_background") or colors.get("background") or "#101019"


def parse_hex(c):
    c = c.lstrip("#")
    return tuple(int(c[i:i + 2], 16) for i in (0, 2, 4))


def background_colors(spec):
    if spec == "theme":
        return theme_gradient() or PRESETS["midnight"]
    if spec in PRESETS:
        return PRESETS[spec]
    m = re.fullmatch(r"(#[0-9a-fA-F]{6})(?::(#[0-9a-fA-F]{6}))?", spec)
    if m:
        return m.group(1), m.group(2) or m.group(1)
    return None


def rounded_sdf(cx, cy, hw, hh, r):
    """ffmpeg expression: signed distance from pixel (X,Y) to a rounded rect."""
    qx = f"(abs(X+0.5-{cx:.2f})-{hw - r:.2f})"
    qy = f"(abs(Y+0.5-{cy:.2f})-{hh - r:.2f})"
    return f"(hypot(max({qx},0),max({qy},0))+min(max({qx},{qy}),0)-{r:.2f})"


def run_ffmpeg(args, what):
    proc = subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y"] + args,
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise RenderError("ffmpeg_failed", f"ffmpeg failed while {what}: {proc.stderr.strip()[-400:]}")


def make_backdrop(path, cw, ch, card, radius, spec, blur, shadow, inset, inset_color):
    """Background with the card's shadow (and inset border fill) baked in."""
    x, y, bw, bh = card
    colors = None
    image = None
    if spec == "wallpaper":
        image = os.path.realpath(WALLPAPER)
        if not os.path.isfile(image):
            raise RenderError("usage", "No Omarchy wallpaper found (~/.local/state/omarchy/current/background)")
        if blur is None:
            blur = 28
    elif os.path.isfile(spec):
        image = spec
    else:
        colors = background_colors(spec)
        if not colors:
            raise RenderError("usage", f"Unknown background: {spec} (use theme, wallpaper, {', '.join(PRESETS)}, "
                                       "#rrggbb[:#rrggbb] or an image path)")
    if colors:
        (r1, g1, b1), (r2, g2, b2) = parse_hex(colors[0]), parse_hex(colors[1])
        t = "((X/W)*0.45+(Y/H)*0.55)"
        bg = f"geq=r='{r1}+({r2 - r1})*{t}':g='{g1}+({g2 - g1})*{t}':b='{b1}+({b2 - b1})*{t}'"
        bg_input = ["-f", "lavfi", "-i", f"color=black:s={cw}x{ch}:d=1,format=rgb24"]
    else:
        bg = f"scale={cw}:{ch}:force_original_aspect_ratio=increase,crop={cw}:{ch},format=rgb24"
        if blur:
            bg += f",gblur=sigma={blur * ch / 1080:.1f}"
        bg_input = ["-i", image]
    graph = [f"[0:v]{bg}[b]"]
    layers = "[b]"
    inputs = list(bg_input)
    if shadow > 0:
        sigma = (0.02 + 0.025 * shadow) * ch
        sdf = rounded_sdf(x + bw / 2, y + bh / 2 + (0.006 + 0.012 * shadow) * ch, bw / 2, bh / 2, radius)
        inputs += ["-f", "lavfi", "-i", f"color=black:s={cw}x{ch}:d=1,format=rgba"]
        graph.append(f"[1:v]geq=r=0:g=0:b=0:a='255*{min(0.9, 0.76 * shadow):.3f}*exp(-pow(max({sdf},0)/{sigma:.2f},2))'[s]")
        graph.append(f"{layers}[s]overlay=format=rgb[bs]")
        layers = "[bs]"
    if inset > 0:
        r, g, b = parse_hex(inset_color)
        sdf = rounded_sdf(x + bw / 2, y + bh / 2, bw / 2, bh / 2, radius)
        idx = len([a for a in inputs if a == "-i"])
        inputs += ["-f", "lavfi", "-i", f"color=black:s={cw}x{ch}:d=1,format=rgba"]
        graph.append(f"[{idx}:v]geq=r={r}:g={g}:b={b}:a='255*0.9*clip(0.5-{sdf},0,1)'[i]")
        graph.append(f"{layers}[i]overlay=format=rgb[bi]")
        layers = "[bi]"
    graph.append(f"{layers}format=rgb24[out]")
    run_ffmpeg(inputs + ["-filter_complex", ";".join(graph), "-map", "[out]", "-frames:v", "1", path],
               "drawing the background")


def make_mask(path, w, h, radius):
    sdf = rounded_sdf(w / 2, h / 2, w / 2, h / 2, radius)
    run_ffmpeg(["-f", "lavfi", "-i", f"color=black:s={w}x{h}:d=1,format=gray",
                "-vf", f"geq=lum='255*clip(0.5-{sdf},0,1)'", "-frames:v", "1", path], "drawing the rounded mask")


def make_bubble(path, d, border):
    """White ring plus soft shadow drawn around a d x d webcam circle; returns the padding."""
    pad = int(math.ceil(d * 0.12))
    size = d + 2 * pad
    c = size / 2
    r = d / 2
    rgba = bytearray(size * size * 4)
    for y in range(size):
        for x in range(size):
            dist = math.hypot(x + 0.5 - c, y + 0.5 - c - d * 0.02)
            shadow = 0.5 * math.exp(-((max(0.0, dist - r) / (d * 0.05)) ** 2))
            ring = clamp(r + border + 0.5 - math.hypot(x + 0.5 - c, y + 0.5 - c), 0.0, 1.0)
            a = ring + shadow * (1 - ring)
            v = int(255 * ring / a) if a > 0 else 0
            k = (y * size + x) * 4
            rgba[k:k + 4] = bytes((v, v, v, int(a * 255)))
    write_png(path, size, size, rgba)
    return pad


# ------------------------------------------------------------------ layout

def canvas_size(fmt, size, w, h):
    if fmt == "source":
        if not size:
            return even(w), even(h)
        k = size / min(w, h)
        return even(w * k), even(h * k)
    a, b = FORMATS[fmt]
    short = size or 1080
    return (even(short * a / b), even(short)) if a >= b else (even(short), even(short * b / a))


def fit(aspect, avail_w, avail_h):
    if avail_w / avail_h > aspect:
        return even(avail_h * aspect), even(avail_h)
    return even(avail_w), even(avail_w / aspect)


# ------------------------------------------------------------------ render

def output_path(video, opts):
    base = os.path.splitext(video)[0] + "-studio"
    if opts.format != "source":
        base += "-" + opts.format.replace(":", "x")
    if opts.quality == "preview":
        base += "-preview"
    return base + (".gif" if opts.export == "gif" else ".mp4")


def encode(cmd_head, graph_file, tail_args, tmp_out, duration, progress_span):
    """Run the main ffmpeg pass, streaming progress; returns stderr on failure."""
    cmd = cmd_head + [ffmpeg_script_flag(), graph_file] + tail_args + ["-progress", "pipe:1", tmp_out]
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    lo, hi = progress_span
    try:
        last_pct = -1
        for line in proc.stdout:
            key, _, val = line.strip().partition("=")
            if key == "out_time_us" and val.isdigit():
                pct = min(99, int((lo + (hi - lo) * min(1.0, int(val) / 1e6 / duration)) * 100))
                if pct != last_pct:
                    last_pct = pct
                    emit({"progress": pct / 100})
                    if not JSON_MODE:
                        print(f"\r{pct:3d}%", end="", file=sys.stderr, flush=True)
        err = proc.stderr.read()
    except BaseException:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        if os.path.exists(tmp_out):
            os.remove(tmp_out)
        raise
    if proc.wait() != 0:
        if os.path.exists(tmp_out):
            os.remove(tmp_out)
        return err.strip()[-400:] or f"exit {proc.returncode}"
    return None


def render(opts):
    video = os.path.abspath(opts.video)
    if not os.path.isfile(video):
        raise RenderError("not_found", f"No such video: {video}")
    for tool in ("ffmpeg", "ffprobe"):
        if not shutil.which(tool):
            raise RenderError("missing_dependency", f"Missing: {tool}. Install with: sudo pacman -S ffmpeg")
    if opts.format != "source" and opts.format not in FORMATS:
        raise RenderError("usage", f"Unknown format: {opts.format} (use source, {', '.join(FORMATS)})")
    if opts.inset_color and not re.fullmatch(r"#[0-9a-fA-F]{6}", opts.inset_color):
        raise RenderError("usage", f"--inset-color must be #rrggbb: {opts.inset_color}")
    info = probe(video)
    src_w, src_h, src_fps, duration = info["w"], info["h"], info["fps"], info["duration"]
    preview = opts.quality == "preview"
    gif = opts.export == "gif"

    # Work resolution/frame rate: everything (camera, cursor) is computed in this space.
    if opts.fps:
        fps = clamp(opts.fps, 10.0, 120.0)
    elif preview:
        fps = min(src_fps, 30.0)
    else:
        fps = max(src_fps, 60.0)
    if gif:
        fps = min(fps, 30.0)
    ws = 0.5 if preview and min(src_w, src_h) >= 720 else 1.0
    w, h = even(src_w * ws), even(src_h * ws)
    n_frames = max(1, int(round(duration * fps)))

    events_path = opts.events or default_events_path(video)
    have_events = os.path.isfile(events_path)
    edits_path = opts.edits or sidecar(video, ".edit.json")
    edits = clean_edits(None if opts.no_edits else load_json(edits_path, "edits"), duration)
    session = load_json(sidecar(video, ".session.json"), "session") or {}
    pieces = timeline_pieces(edits, duration)
    edited = pieces != [(0.0, duration, 1.0)]
    out_duration = sum((b - a) / r for a, b, r in pieces)
    plan_only = opts.cmd == "plan"
    out = os.path.abspath(opts.out or output_path(video, opts)) if not plan_only else None
    if out == video:
        raise RenderError("usage", "--out must differ from the input video")

    # Canvas and card geometry.
    size = opts.size
    if preview:
        size = max(360, int((size or min(canvas_size(opts.format, None, src_w, src_h))) / 2))
    if gif:
        size = min(size or 720, 720)
    cw, ch = canvas_size(opts.format, size, src_w, src_h)
    canvas_aspect = cw / ch
    src_aspect = w / h
    layout = opts.layout
    if layout == "auto":
        layout = "fill" if opts.format != "source" and abs(math.log(canvas_aspect / src_aspect)) > 0.25 else "fit"
    video_aspect = canvas_aspect if layout == "fill" else src_aspect
    pad = clamp(opts.padding, 0.0, 0.3)
    inset = max(0.0, opts.inset) * ch / 1080 if pad > 0 else 0.0
    avail_w, avail_h = cw * (1 - 2 * pad) - 2 * inset, ch * (1 - 2 * pad) - 2 * inset
    vid_w, vid_h = fit(video_aspect, avail_w, avail_h) if pad > 0 else (cw, ch)
    vid_x, vid_y = (cw - vid_w) // 2, (ch - vid_h) // 2
    card = (vid_x - inset, vid_y - inset, vid_w + 2 * inset, vid_h + 2 * inset)
    radius = max(0.0, opts.radius * ch / 1080 if opts.radius is not None else 0.018 * ch) if pad > 0 else 0.0
    vid_radius = max(0.0, radius - inset * 0.6)
    if video_aspect >= src_aspect:
        view = (w, w / video_aspect)
    else:
        view = (h * video_aspect, h)

    cursor = [None] * n_frames
    raw = [None] * n_frames
    shapes = ["arrow"] * n_frames
    segments, clicks_v = [], []
    cursor_scale = ws
    if have_events:
        meta, moves, clicks, keys, end = load_events(events_path)
        region = meta["region"]
        sx, sy = w / float(region["w"]), h / float(region["h"])
        offset = capture_offset(meta, session, end, duration)

        def map_xy(x, y):
            return (x - region["x"]) * sx, (y - region["y"]) * sy

        raw = sample_cursor(moves, n_frames, fps, offset, map_xy)
        cursor = smooth_cursor(moves, n_frames, fps, offset, map_xy, opts.smoothing, JITTER)
        shapes = cursor_shapes(cursor, load_windows(events_path), fps, offset, map_xy)
        clicks_v = [t - offset for t in clicks if 0 <= t - offset < duration]
        keys_v = [t - offset for t in keys if 0 <= t - offset < duration]
        focus = clicks_v if (clicks_v or meta.get("input") == "evdev") else dwell_points(raw, fps, sx)
        if opts.zoom > 1.0:
            segments = zoom_segments(focus, keys_v, duration, raw, fps, opts.zoom)
        cursor_scale = sx
    else:
        log(f"No events file ({events_path}); framing only.")

    def seg_json(seg):
        return {"start": round(seg["start"], 3), "end": round(seg["end"], 3), "zoom": seg["zoom"],
                "x": round(seg["focus"][0][1] / w, 4), "y": round(seg["focus"][0][2] / h, 4),
                "follow": seg.get("follow", True)}

    auto_segments = [seg_json(sg) for sg in segments]
    if edits["zooms"] is not None:
        segments = [{"start": z["start"], "end": z["end"], "zoom": z["zoom"], "follow": z["follow"],
                     "focus": explicit_focus(z, clicks_v, raw, fps, w, h)}
                    for z in edits["zooms"] if z["zoom"] > 1.0]
    cam_path = session.get("webcam")
    cam_path = os.path.join(os.path.dirname(sidecar(video, "")), os.path.basename(cam_path)) if isinstance(cam_path, str) else None
    has_webcam = bool(cam_path and os.path.isfile(cam_path))
    tracks = session.get("audio") if isinstance(session.get("audio"), list) else []
    split_audio = "system" in tracks and "mic" in tracks and info["audio_tracks"] >= len(tracks)
    if plan_only:
        return {"ok": True, "video": video, "duration": duration, "width": src_w, "height": src_h, "fps": src_fps,
                "audio": info["audio"], "audioTracks": tracks if split_audio else (["mix"] if info["audio"] else []),
                "webcam": has_webcam, "events": have_events, "autoSegments": auto_segments,
                "segments": [seg_json(sg) for sg in segments], "edits": edits, "editsFile": edits_path,
                "cursorTrack": cursor_track_json(raw, fps, w, h),
                "outputDuration": out_duration}

    segments = frame_segments(video, segments, w, h, view, edits["zooms"] is not None)
    camera = camera_path(cursor, n_frames, fps, w, h, view, segments, layout == "fill")

    encoder = opts.encoder
    device = None
    if encoder in ("auto", "vaapi") and not gif:
        device = vaapi_device()
        if device and vaapi_works(device):
            encoder = "vaapi"
        elif encoder == "vaapi":
            raise RenderError("vaapi_unavailable", "VAAPI encoding isn't available on this machine (try --encoder x264)")
        else:
            encoder = "x264"
    elif encoder == "auto":
        encoder = "x264"

    work = tempfile.mkdtemp(prefix="creator-mode-studio-", dir=os.environ.get("XDG_RUNTIME_DIR") or None)
    try:
        inputs = ["-i", video]
        graph = []
        head = "[0:v]"
        pre = []
        if abs(fps - src_fps) > 0.01:
            pre.append(f"fps={fps:g}")
        if (w, h) != (src_w, src_h):
            pre.append(f"scale={w}:{h}:flags=bicubic")
        pre.append("format=yuv420p")
        src = "[v0]"
        draw_cursor = have_events and not opts.no_cursor and any(p is not None for p in cursor)
        next_input = 1

        graph.append(f"{head}{','.join(pre)}[v0]")
        step = max(1, int(round(fps / 15)))
        out_vw, out_vh = (vid_w, vid_h) if pad > 0 else (cw, ch)
        # The cursor is drawn after the zoom, at output resolution, so it stays
        # sharp and moves in whole output pixels instead of magnified ones.
        cursor_chain, pos_cmd = [], None
        if draw_cursor:
            k0 = out_vw / view[0]
            sheet, ring_png = os.path.join(work, "cursor.png"), os.path.join(work, "ring.png")
            zmax = max([sg["zoom"] for sg in segments] + [1.0])
            levels = cursor_levels(min(CURSOR_GROW_MAX, zmax ** ZOOM_CURSOR))
            used = ("arrow", "ibeam") if "ibeam" in shapes else ("arrow",)
            tw, th, hot, rows = make_cursor_sheet(sheet, 22 * cursor_scale * opts.cursor_scale * k0, levels, used)
            ring_size = make_ring_sheet(ring_png, 16 * cursor_scale * k0, 3 * cursor_scale * k0)
            clicks_f = sorted(int(round(t * fps)) for t in clicks_v)
            blur = opts.motion_blur and not preview and not gif
            tracks_ = cursor_track(cursor, raw, clicks_f, fps, w, h, cursor_scale, opts.hide_idle, blur)
            cam_eff = camera_keyframed(camera, step)
            main, g1, g2, ring = (to_output(t_, cam_eff, out_vw, out_vh) for t_ in tracks_)
            zooms = [view[0] / c[2] for c in cam_eff]
            main, g1, g2 = (pick_tiles(t_, zooms, shapes, levels, rows) for t_ in (main, g1, g2))
            layers = [("ring", ring, ring_size, ring_size, ring_size / 2, ring_size / 2),
                      ("g2", g2, tw, th, hot, hot), ("g1", g1, tw, th, hot, hot),
                      ("cur", main, tw, th, hot, hot)]
            layers = [ly for ly in layers if any(s_ is not None for s_ in ly[1])]
            if layers:
                crop_lines, pos_lines = sprite_commands(layers, fps)
                crop_cmd, pos_cmd = os.path.join(work, "sprites.cmd"), os.path.join(work, "cursor.cmd")
                with open(crop_cmd, "w") as f:
                    f.write("\n".join(crop_lines or ["0.0 crop@none x 0;"]) + "\n")
                with open(pos_cmd, "w") as f:
                    f.write("\n".join(pos_lines) + "\n")
                cursor_layers = [ly for ly in layers if ly[0] != "ring"]
                if any(ly[0] == "ring" for ly in layers):
                    inputs += ["-loop", "1", "-framerate", f"{fps:g}", "-i", ring_png]
                    ring_in = next_input
                    next_input += 1
                if cursor_layers:
                    inputs += ["-loop", "1", "-framerate", f"{fps:g}", "-i", sheet]
                    sheet_in = next_input
                    next_input += 1
                sprite_streams = {}
                # one sendcmd reaches every filter in the graph; it sits on a
                # sprite stream so tile changes land on the matching sprite frame
                sendc = f"sendcmd=f='{crop_cmd}',"
                if any(ly[0] == "ring" for ly in layers):
                    graph.append(f"[{ring_in}:v]{sendc}crop@ring=w={ring_size}:h={ring_size}:x=0:y=0[sp_ring]")
                    sprite_streams["ring"] = "[sp_ring]"
                    sendc = ""
                if cursor_layers:
                    names = [ly[0] for ly in cursor_layers]
                    if len(names) > 1:
                        graph.append(f"[{sheet_in}:v]{sendc}split={len(names)}" + "".join(f"[sh_{n}]" for n in names))
                    else:
                        graph.append(f"[{sheet_in}:v]{sendc}null[sh_{names[0]}]")
                    for name in names:
                        graph.append(f"[sh_{name}]crop@{name}=w={tw}:h={th}:x=0:y=0[sp_{name}]")
                        sprite_streams[name] = f"[sp_{name}]"
                cursor_chain = [(ly[0], sprite_streams[ly[0]]) for ly in layers]
            else:
                draw_cursor = False

        def scaled(src, sw, sh):
            """Scale the (zoomed) screen to its output size and draw the cursor on it."""
            chain = f"scale={sw}:{sh}:flags=lanczos"
            if not cursor_chain:
                graph.append(f"{src}{chain}[sv]")
                return "[sv]"
            graph.append(f"{src}{chain},format=yuv420p,sendcmd=f='{pos_cmd}'[sv]")
            src = "[sv]"
            for i, (name, stream) in enumerate(cursor_chain):
                graph.append(f"{src}{stream}overlay@{name}=x={OFF}:y={OFF}:shortest=1[cv{i}]")
                src = f"[cv{i}]"
            return src

        full = all(abs(l0) < 0.5 and abs(t0) < 0.5 and abs(vw - w) < 0.5 and abs(vh - h) < 0.5
                   for l0, t0, vw, vh in camera)
        if not full:
            left = [c[0] for c in camera]
            top = [c[1] for c in camera]
            right = [c[0] + c[2] - w for c in camera]
            bottom = [c[1] + c[3] - h for c in camera]
            L, T = piecewise_expr(left, step), piecewise_expr(top, step)
            R, B = f"W+{piecewise_expr(right, step)}", f"H+{piecewise_expr(bottom, step)}"
            graph.append(f"{src}perspective=x0='{L}':y0='{T}':x1='{R}':y1='{T}':x2='{L}':y2='{B}':x3='{R}':y3='{B}'"
                         f":interpolation=cubic:eval=frame[z]")
            src = "[z]"
            windows = blur_windows(camera, fps, vid_w, ch) if opts.camera_blur and opts.motion_blur and not preview and not gif else []
            if windows:
                enable = "+".join(f"between(t,{a:.3f},{b:.3f})" for a, b in windows)
                graph.append(f"{src}split[za][zb];[zb]tmix=frames=3:weights='1 2 1'[zbl];"
                             f"[za][zbl]overlay=enable='{enable}':shortest=1[zm]")
                src = "[zm]"

        if pad > 0:
            backdrop, mask = os.path.join(work, "backdrop.png"), os.path.join(work, "mask.png")
            make_backdrop(backdrop, cw, ch, card, radius, opts.background, opts.blur,
                          clamp(opts.shadow, 0.0, 1.0), inset, opts.inset_color or "#ffffff")
            make_mask(mask, vid_w, vid_h, vid_radius)
            inputs += ["-loop", "1", "-framerate", f"{fps:g}", "-i", backdrop,
                       "-loop", "1", "-framerate", f"{fps:g}", "-i", mask]
            b, m = next_input, next_input + 1
            src = scaled(src, vid_w, vid_h)
            graph.append(f"{src}format=yuva420p[c0v]")
            graph.append(f"[{m}:v]format=gray[mk]")
            graph.append("[c0v][mk]alphamerge[c1v]")
            graph.append(f"[{b}:v]format=yuv420p[bgv]")
            graph.append(f"[bgv][c1v]overlay={vid_x}:{vid_y}:shortest=1:format=auto[comp]")
            next_input += 2
        else:
            src = scaled(src, cw, ch)
            graph.append(f"{src}null[comp]")
        src = "[comp]"

        cam = edits["webcam"]
        use_webcam = has_webcam and cam["enabled"] and not opts.no_webcam
        if use_webcam:
            cam_info = probe(cam_path)
            lead = webcam_lead(session, cam_info["duration"], duration)
            d = even(min(cw, ch) * cam["size"])
            margin = int(round(min(cw, ch) * 0.045))
            border = max(2, int(round(d * 0.025)))
            x = margin if cam["corner"] in ("bl", "tl") else cw - margin - d
            y = margin if cam["corner"] in ("tl", "tr") else ch - margin - d
            frame_png, cmask = os.path.join(work, "bubble.png"), os.path.join(work, "bubble-mask.png")
            fpad = make_bubble(frame_png, d, border)
            make_mask(cmask, d, d, d / 2)
            if lead < 0:
                inputs += ["-itsoffset", f"{-lead:.3f}"]
            inputs += ["-i", cam_path, "-loop", "1", "-framerate", f"{fps:g}", "-i", frame_png,
                       "-loop", "1", "-framerate", f"{fps:g}", "-i", cmask]
            ci, fi, mi = next_input, next_input + 1, next_input + 2
            next_input += 3
            trim = f"trim=start={lead:.3f},setpts=PTS-STARTPTS," if lead > 0 else ""
            graph.append(f"[{ci}:v]{trim}fps={fps:g},{'hflip,' if cam['mirror'] else ''}"
                         f"scale={d}:{d}:force_original_aspect_ratio=increase,crop={d}:{d},format=yuva420p[cam0]")
            graph.append(f"[{mi}:v]format=gray[cmk]")
            graph.append("[cam0][cmk]alphamerge[cam1]")
            graph.append(f"{src}[{fi}:v]overlay={x - fpad}:{y - fpad}:shortest=1[bub]")
            graph.append(f"[bub][cam1]overlay={x}:{y}:eof_action=pass[wc]")
            src = "[wc]"

        vol = edits["audio"]
        sys_v = opts.system_volume if opts.system_volume is not None else vol["system"]
        mic_v = opts.mic_volume if opts.mic_volume is not None else vol["mic"]
        denoise = opts.denoise or vol["denoise"]
        audio_label = None
        if info["audio"] and not gif:
            if split_audio:
                si, mi_ = tracks.index("system"), tracks.index("mic")
                graph.append(f"[0:a:{si}]volume={sys_v:.3f}[as]")
                graph.append(f"[0:a:{mi_}]{'afftdn=nf=-25,' if denoise else ''}volume={mic_v:.3f}[am]")
                graph.append("[as][am]amix=inputs=2:normalize=0:duration=longest[aud]")
                audio_label = "[aud]"
            elif edited or abs(sys_v - 1) > 1e-3 or denoise:
                graph.append(f"[0:a:0]{'afftdn=nf=-25,' if denoise else ''}volume={sys_v:.3f}[aud]")
                audio_label = "[aud]"
        if edited:
            n = len(pieces)
            graph.append(f"{src}split={n}" + "".join(f"[pv{i}]" for i in range(n)) if n > 1 else f"{src}null[pv0]")
            if audio_label:
                graph.append(f"{audio_label}asplit={n}" + "".join(f"[pa{i}]" for i in range(n)) if n > 1 else f"{audio_label}anull[pa0]")
            cat = []
            for i, (a, b, r) in enumerate(pieces):
                graph.append(f"[pv{i}]trim=start={a:.3f}:end={b:.3f},setpts=(PTS-STARTPTS)/{r:.4f}[qv{i}]")
                cat.append(f"[qv{i}]")
                if audio_label:
                    graph.append(f"[pa{i}]atrim=start={a:.3f}:end={b:.3f},asetpts=PTS-STARTPTS,{atempo(r)}[qa{i}]")
                    cat.append(f"[qa{i}]")
            graph.append("".join(cat) + f"concat=n={n}:v=1:a={1 if audio_label else 0}[catv]" + ("[cata]" if audio_label else ""))
            graph.append(f"[catv]fps={fps:g}[ed]")
            src = "[ed]"
            if audio_label:
                audio_label = "[cata]"
        graph.append(f"{src}format=yuv420p[out]")

        script = os.path.join(work, "graph.txt")
        with open(script, "w") as f:
            f.write(";\n".join(graph))

        head_cmd = ["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostats", "-y"]
        tail = ["-map", "[out]"]
        if audio_label:
            tail += ["-map", audio_label, "-c:a", "aac", "-b:a", "192k"]
        elif info["audio"] and not gif:
            tail += ["-map", "0:a:0", "-c:a", "copy"]
        tail += ["-r", f"{fps:g}", "-t", f"{out_duration:.3f}"]
        if gif:
            mid = os.path.join(work, "gif-source.mp4")
            tmp_out = mid
            tail += ["-c:v", "libx264", "-preset", "veryfast", "-crf", "14", "-pix_fmt", "yuv420p"]
            span = (0.0, 0.85)
        else:
            tmp_out = os.path.join(os.path.dirname(out), "." + os.path.basename(out) + ".part.mp4")
            tail += ["-movflags", "+faststart"]
            span = (0.0, 1.0)

        def x264_args():
            preset = "veryfast" if preview else opts.preset
            return ["-c:v", "libx264", "-preset", preset, "-crf", str(26 if preview else opts.crf), "-pix_fmt", "yuv420p"]

        log(f"Rendering {os.path.basename(out)} ({len(segments)} zoom{'s' if len(segments) != 1 else ''}, {encoder})…")
        err = None
        if encoder == "vaapi" and not gif:
            vgraph = os.path.join(work, "graph-vaapi.txt")
            with open(vgraph, "w") as f:
                f.write(";\n".join(graph[:-1] + [graph[-1].replace("format=yuv420p[out]", "format=nv12,hwupload[out]")]))
            qp = "28" if preview else str(max(10, opts.crf + 2))
            err = encode(head_cmd + ["-vaapi_device", device] + inputs, vgraph,
                         tail + ["-c:v", "h264_vaapi", "-qp", qp], tmp_out, out_duration, span)
            if err:
                if opts.encoder == "vaapi":
                    raise RenderError("ffmpeg_failed", f"VAAPI encode failed: {err}")
                log(f"VAAPI encode failed, falling back to x264: {err}")
                encoder = "x264"
                err = None
        if encoder == "x264" or gif:
            err = encode(head_cmd + inputs, script, tail + x264_args(), tmp_out, out_duration, span)
        if err:
            raise RenderError("ffmpeg_failed", f"ffmpeg failed while rendering: {err}")

        if gif:
            palette = os.path.join(work, "palette.png")
            gfps = min(opts.gif_fps, fps)
            run_ffmpeg(["-i", mid, "-vf", f"fps={gfps:g},palettegen=stats_mode=diff", palette], "building the GIF palette")
            emit({"progress": 0.9})
            tmp_gif = os.path.join(os.path.dirname(out), "." + os.path.basename(out) + ".part.gif")
            try:
                run_ffmpeg(["-i", mid, "-i", palette, "-lavfi",
                            f"fps={gfps:g}[x];[x][1:v]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle",
                            tmp_gif], "writing the GIF")
            except BaseException:
                if os.path.exists(tmp_gif):
                    os.remove(tmp_gif)
                raise
            os.replace(tmp_gif, out)
        else:
            os.replace(tmp_out, out)
        if not JSON_MODE:
            print("\r100%", file=sys.stderr)
        seg_out = [seg_json(sg) for sg in segments]
        return {"ok": True, "file": out, "duration": out_duration, "zooms": len(segments), "segments": seg_out,
                "edited": edited, "webcam": use_webcam, "audioMix": bool(audio_label),
                "cursor": draw_cursor, "encoder": "gif" if gif else encoder,
                "format": opts.format, "layout": layout, "size": [cw, ch],
                "events": events_path if have_events else None}
    finally:
        if not opts.keep_temp:
            shutil.rmtree(work, ignore_errors=True)
        else:
            log(f"Kept work dir: {work}")


def interrupted(signum, _frame):
    raise KeyboardInterrupt


def main():
    global JSON_MODE
    parser = argparse.ArgumentParser(prog="creator-mode-studio", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    common = argparse.ArgumentParser(add_help=False)
    r = common
    r.add_argument("video")
    r.add_argument("--edits", help="timeline edits (default: .creator-mode/<name>.edit.json when it exists)")
    r.add_argument("--no-edits", action="store_true", help="ignore the edit file")
    r.add_argument("--no-webcam", action="store_true", help="leave out the webcam bubble")
    r.add_argument("--system-volume", type=float, help="desktop audio gain (default from edits, else 1)")
    r.add_argument("--mic-volume", type=float, help="microphone gain, for recordings with a separate mic track")
    r.add_argument("--denoise", action="store_true", help="reduce background noise on the microphone")
    r.add_argument("--events", help="events file (default: next to the video in .creator-mode/)")
    r.add_argument("--out", help="output file (default: <video>-studio[-FORMAT][-preview].mp4|gif)")
    r.add_argument("--zoom", type=float, default=1.8, help="zoom level on clicks; 1 disables zoom (default 1.8)")
    r.add_argument("--background", default="theme",
                   help=f"theme | wallpaper | {' | '.join(PRESETS)} | #rrggbb[:#rrggbb] | image path (default theme)")
    r.add_argument("--blur", type=float, help="background image blur (default 28 for wallpaper, 0 for images)")
    r.add_argument("--padding", type=float, default=0.06, help="padding as a fraction of the frame; 0 = no frame")
    r.add_argument("--radius", type=float, help="corner radius in px at 1080p (default ~19)")
    r.add_argument("--shadow", type=float, default=0.5, help="shadow strength 0..1 (default 0.5)")
    r.add_argument("--inset", type=float, default=0, help="inset border width in px at 1080p (default 0)")
    r.add_argument("--inset-color", help="inset border color #rrggbb (default #ffffff)")
    r.add_argument("--format", default="source", help=f"source | {' | '.join(FORMATS)} (default source)")
    r.add_argument("--layout", default="auto", choices=("auto", "fit", "fill"),
                   help="fit keeps the whole recording; fill crops it to the format and follows the cursor")
    r.add_argument("--size", type=int, help="short side of the output in px (default: source, 1080 for formats)")
    r.add_argument("--export", default="mp4", choices=("mp4", "gif"))
    r.add_argument("--gif-fps", type=float, default=15)
    r.add_argument("--quality", default="final", choices=("final", "preview"),
                   help="preview renders at half size and 30 fps without motion blur")
    r.add_argument("--encoder", default="auto", choices=("auto", "x264", "vaapi"),
                   help="auto uses VAAPI when a test encode works, else x264")
    r.add_argument("--fps", type=float,
                   help="output frame rate (default: 60 or the source's if higher; preview 30)")
    r.add_argument("--smoothing", type=float, default=0.55, help="cursor smoothing 0..1 (default 0.55)")
    r.add_argument("--hide-idle", type=float, default=2.5, help="hide the cursor after N idle seconds; 0 never")
    r.add_argument("--cursor-scale", type=float, default=1.4, help="cursor size multiplier (default 1.4)")
    r.add_argument("--no-cursor", action="store_true", help="don't draw a cursor")
    r.add_argument("--no-motion-blur", dest="motion_blur", action="store_false")
    r.add_argument("--camera-blur", action="store_true",
                   help="also blur fast zoom/pan moves (frame blending; can ghost at 30 fps)")
    r.add_argument("--preset", default="medium", help="x264 preset (default medium)")
    r.add_argument("--crf", type=int, default=18, help="x264 quality, lower is better (default 18)")
    r.add_argument("--json-progress", action="store_true", help="machine-readable progress on stdout")
    r.add_argument("--keep-temp", action="store_true", help=argparse.SUPPRESS)
    sub.add_parser("render", parents=[common], help="render the studio cut of a recording")
    sub.add_parser("plan", parents=[common], help="print the zoom plan and edits as JSON without rendering")
    opts = parser.parse_args()
    JSON_MODE = opts.json_progress
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    try:
        result = render(opts)
    except RenderError as e:
        if JSON_MODE:
            emit({"ok": False, "error": e.code, "message": e.message})
        else:
            print(f"creator-mode-studio: {e.message}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
    if JSON_MODE or opts.cmd == "plan":
        print(json.dumps(result), flush=True)
    else:
        print(result["file"])


if __name__ == "__main__":
    main()
