#!/bin/bash
#
# creator-mode-rec — recording controller for the Creator Mode Omarchy plugin.
#
#   creator-mode-rec check                       dependencies + output dir
#   creator-mode-rec status                      idle | recording | crashed
#   creator-mode-rec pick                        Omarchy's region/window/monitor picker
#   creator-mode-rec start [--audio=MODE] [--target=TARGET] [--studio=on|off] [--webcam=on|off]
#                                                MODE: none | desktop | desktop+mic
#                                                TARGET: focused | monitor:NAME | region:WxH+X+Y
#                                                studio: also log the cursor/clicks for
#                                                the studio render (and hide the real cursor)
#   creator-mode-rec stop                        stop OUR recording and verify the file
#   creator-mode-rec render <file> [--background=BG] [--zoom=N] [--format=F] [--quality=Q] [--export=mp4|gif]
#                                                studio cut: auto-zoom, smooth cursor, frame;
#                                                streams {"progress":0..1} lines, then the result
#   creator-mode-rec edit <file>                 open the timeline editor in the browser
#   creator-mode-rec reveal <file>               open the folder containing <file>
#
# Every command prints exactly one JSON object on stdout. Failures also exit
# non-zero and carry {"ok":false,"error":<code>,"message":<human text>}.
#
# Only the recorder PID recorded in the state dir is ever signalled, and only
# after /proc confirms it is still the process writing our output file.

set -uo pipefail

STATE_DIR="${CREATOR_MODE_STATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/creator-mode}"
STATE_FILE="$STATE_DIR/state"
LOG_FILE="$STATE_DIR/recorder.log"
LOCK_FILE="$STATE_DIR/lock"
RECORDER="${CREATOR_MODE_RECORDER:-gpu-screen-recorder}"
START_TIMEOUT="${CREATOR_MODE_START_TIMEOUT:-8}"
STOP_TIMEOUT="${CREATOR_MODE_STOP_TIMEOUT:-20}"
PICKER="${CREATOR_MODE_PICKER:-omarchy-capture-region}"
BIN_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
TRACKER="${CREATOR_MODE_TRACKER:-$BIN_DIR/creator-mode-track}"
STUDIO="${CREATOR_MODE_STUDIO:-$BIN_DIR/creator-mode-studio}"
TRACKER_LOG="$STATE_DIR/tracker.log"
EDITOR_BIN="${CREATOR_MODE_EDITOR:-$BIN_DIR/creator-mode-editor}"
WEBCAM_DEVICE="${CREATOR_MODE_WEBCAM_DEVICE:-/dev/video0}"
WEBCAM_FORMAT="${CREATOR_MODE_WEBCAM_FORMAT:-v4l2}"
WEBCAM_LOG="$STATE_DIR/webcam.log"
HIDE_CURSOR="${CREATOR_MODE_HIDE_CURSOR:-auto}"
HIDDEN_CURSOR_THEME="creator-mode-hidden"
CURSOR_THEME_DIR="${CREATOR_MODE_CURSOR_THEME_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/icons/$HIDDEN_CURSOR_THEME}"
CURSOR_THEME_BUILDER="$BIN_DIR/creator-mode-cursor-theme"

json_str() {
  local s
  s=$(printf '%s' "${1-}" | tr -d '\000-\010\013\014\016-\037')
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/}
  s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

fail() {
  local code=$1 message=$2 extra=${3:-}
  printf '{"ok":false,"error":%s,"message":%s%s}\n' "$(json_str "$code")" "$(json_str "$message")" "$extra"
  exit 1
}

now_ms() { date +%s%3N; }

output_dir() {
  # shellcheck source=/dev/null
  [[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
  echo "${OMARCHY_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"
}

ensure_output_dir() {
  local dir
  dir=$(output_dir)
  if [[ ! -d $dir ]] && ! mkdir -p "$dir" 2>/dev/null; then
    fail "output_dir" "Can't create the recordings folder: $dir"
  fi
  [[ -w $dir ]] || fail "output_dir" "The recordings folder isn't writable: $dir"
  echo "$dir"
}

missing_deps() {
  local missing=()
  command -v "$RECORDER" >/dev/null 2>&1 || missing+=("$RECORDER")
  command -v ffprobe >/dev/null 2>&1 || missing+=("ffprobe")
  command -v flock >/dev/null 2>&1 || missing+=("flock")
  if [[ -z ${CREATOR_MODE_MONITOR:-} ]]; then
    command -v hyprctl >/dev/null 2>&1 || missing+=("hyprctl")
    command -v jq >/dev/null 2>&1 || missing+=("jq")
  fi
  echo "${missing[*]:-}"
}

package_for() {
  case $1 in
  gpu-screen-recorder) echo "gpu-screen-recorder" ;;
  ffprobe) echo "ffmpeg" ;;
  flock) echo "util-linux" ;;
  hyprctl) echo "hyprland" ;;
  jq) echo "jq" ;;
  *) echo "$1" ;;
  esac
}

require_deps() {
  local missing pkgs=() dep
  missing=$(missing_deps)
  [[ -z $missing ]] && return 0
  for dep in $missing; do pkgs+=("$(package_for "$dep")"); done
  fail "missing_dependency" "Missing: $missing. Install with: sudo pacman -S ${pkgs[*]}"
}

with_lock() {
  mkdir -p "$STATE_DIR" || fail "state_dir" "Can't create $STATE_DIR"
  exec 9>"$LOCK_FILE"
  flock -w 5 9 || fail "busy" "Another Creator Mode command is still running. Try again in a moment."
}

load_state() {
  PID=""
  FILE=""
  STARTED=""
  TRACKER_PID=""
  EVENTS=""
  WEBCAM_PID=""
  WEBCAM=""
  CURSOR_THEME=""
  CURSOR_SIZE=""
  [[ -f $STATE_FILE ]] || return 1
  PID=$(sed -n 's/^pid=//p' "$STATE_FILE")
  FILE=$(sed -n 's/^file=//p' "$STATE_FILE")
  STARTED=$(sed -n 's/^started=//p' "$STATE_FILE")
  TRACKER_PID=$(sed -n 's/^tracker_pid=//p' "$STATE_FILE")
  EVENTS=$(sed -n 's/^events=//p' "$STATE_FILE")
  WEBCAM_PID=$(sed -n 's/^webcam_pid=//p' "$STATE_FILE")
  WEBCAM=$(sed -n 's/^webcam=//p' "$STATE_FILE")
  CURSOR_THEME=$(sed -n 's/^cursor_theme=//p' "$STATE_FILE")
  CURSOR_SIZE=$(sed -n 's/^cursor_size=//p' "$STATE_FILE")
  [[ $PID =~ ^[0-9]+$ && -n $FILE ]]
}

# True only while PID is alive AND is the recorder writing our file (guards
# against PID reuse after a crash or reboot).
is_ours_alive() {
  [[ -n ${PID:-} && -r /proc/$PID/cmdline ]] || return 1
  local cmdline
  cmdline=$(tr '\0' '\n' <"/proc/$PID/cmdline" 2>/dev/null) || return 1
  grep -qxF -- "$FILE" <<<"$cmdline"
}

# Same PID-reuse guard for the cursor tracker: it must still be writing EVENTS.
tracker_alive() {
  [[ ${TRACKER_PID:-} =~ ^[0-9]+$ && -n ${EVENTS:-} && -r /proc/$TRACKER_PID/cmdline ]] || return 1
  tr '\0' '\n' <"/proc/$TRACKER_PID/cmdline" 2>/dev/null | grep -qxF -- "$EVENTS"
}

stop_tracker() {
  tracker_alive || return 0
  kill -TERM "$TRACKER_PID" 2>/dev/null
  local waited=0
  while tracker_alive && ((waited < 20)); do
    sleep 0.1
    waited=$((waited + 1))
  done
  tracker_alive && kill -KILL "$TRACKER_PID" 2>/dev/null
  return 0
}

# The desktop's cursor theme: what Hyprland synced to gsettings (so GTK apps
# agree with it), else what the session was started with.
desktop_cursor_theme() {
  local theme=""
  command -v gsettings >/dev/null 2>&1 &&
    theme=$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")
  [[ -z $theme || $theme == "$HIDDEN_CURSOR_THEME" ]] && theme=${HYPRCURSOR_THEME:-${XCURSOR_THEME:-default}}
  echo "$theme"
}

desktop_cursor_size() {
  local size=${HYPRCURSOR_SIZE:-${XCURSOR_SIZE:-24}}
  [[ $size =~ ^[1-9][0-9]*$ ]] || size=24
  echo "$size"
}

# gpu-screen-recorder's `-cursor no` is ignored by some capture paths (Intel
# KMS keeps the cursor plane in the frame), so while a studio recording runs
# Hyprland is switched to a transparent cursor theme. CURSOR_THEME/CURSOR_SIZE
# hold what restore_cursor puts back; they go into the state file so a later
# `stop` (or recovery from a crash) can restore it too.
hide_cursor() {
  CURSOR_THEME="" CURSOR_SIZE=""
  [[ $HIDE_CURSOR != off ]] || return 1
  command -v hyprctl >/dev/null 2>&1 || return 1
  python3 "$CURSOR_THEME_BUILDER" "$CURSOR_THEME_DIR" 2>>"$LOG_FILE" || return 1
  local theme size
  theme=$(desktop_cursor_theme)
  size=$(desktop_cursor_size)
  hyprctl setcursor "$HIDDEN_CURSOR_THEME" "$size" >/dev/null 2>>"$LOG_FILE" || return 1
  CURSOR_THEME=$theme CURSOR_SIZE=$size
}

restore_cursor() {
  [[ -n ${CURSOR_THEME:-} ]] || return 0
  hyprctl setcursor "$CURSOR_THEME" "${CURSOR_SIZE:-24}" >/dev/null 2>>"$LOG_FILE" || hyprctl reload >/dev/null 2>&1
  CURSOR_THEME="" CURSOR_SIZE=""
  return 0
}

# The webcam recorder is an ffmpeg writing WEBCAM; SIGINT lets it finish the file.
webcam_alive() {
  [[ ${WEBCAM_PID:-} =~ ^[0-9]+$ && -n ${WEBCAM:-} && -r /proc/$WEBCAM_PID/cmdline ]] || return 1
  tr '\0' '\n' <"/proc/$WEBCAM_PID/cmdline" 2>/dev/null | grep -qxF -- "$WEBCAM"
}

stop_webcam() {
  webcam_alive || return 0
  kill -INT "$WEBCAM_PID" 2>/dev/null
  local waited=0
  while webcam_alive && ((waited < 40)); do
    sleep 0.1
    waited=$((waited + 1))
  done
  webcam_alive && kill -KILL "$WEBCAM_PID" 2>/dev/null
  return 0
}

webcam_available() {
  [[ $WEBCAM_FORMAT != v4l2 || -c $WEBCAM_DEVICE ]] && command -v ffmpeg >/dev/null 2>&1
}

studio_available() {
  command -v python3 >/dev/null 2>&1 && command -v ffmpeg >/dev/null 2>&1 && [[ -x $TRACKER && -x $STUDIO ]]
}

# The captured area as X,Y,W,H in Hyprland's logical coordinates (what the
# cursor IPC reports), for mapping cursor positions onto the video.
logical_region() {
  local target=$1
  if [[ -n ${CREATOR_MODE_REGION:-} ]]; then
    echo "$CREATOR_MODE_REGION"
  elif [[ $target =~ ^region:([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]]; then
    echo "${BASH_REMATCH[3]},${BASH_REMATCH[4]},${BASH_REMATCH[1]},${BASH_REMATCH[2]}"
  else
    hyprctl monitors -j 2>/dev/null | jq -r --arg name "${target#monitor:}" '
      .[] | select(.name == $name)
      | (if (.transform % 2) == 1 then [.height, .width] else [.width, .height] end) as $wh
      | "\(.x),\(.y),\($wh[0] / .scale | round),\($wh[1] / .scale | round)"' | head -n1
  fi
}

recorder_can_hide_cursor() {
  # gpu-screen-recorder lists it as "-cursor ..." in older help text and as
  # "[-cursor yes|no]" in the 6.x usage line.
  "$RECORDER" --help 2>&1 | grep -qE -- '(^|[[:space:][])-cursor([[:space:]]|$)'
}

foreign_recorder_running() {
  local pids p
  pids=$(pgrep -f '^gpu-screen-recorder' 2>/dev/null) || return 1
  for p in $pids; do
    [[ $p == "${PID:-}" ]] || return 0
  done
  return 1
}

refresh_omarchy_indicator() {
  command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1
  return 0
}

log_tail() {
  [[ -f $LOG_FILE ]] || return 0
  local lines
  lines=$(grep -i 'error' "$LOG_FILE" | tail -n 2)
  [[ -n $lines ]] || lines=$(grep -v '^[[:space:]]*$' "$LOG_FILE" | tail -n 3)
  cut -c1-300 <<<"$lines"
}

focused_monitor() {
  if [[ -n ${CREATOR_MODE_MONITOR:-} ]]; then
    echo "$CREATOR_MODE_MONITOR"
    return
  fi
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' | head -n1
}

# Mirrors omarchy-capture-screenrecording: cap capture at 4K, else native.
capture_size() {
  [[ -n ${CREATOR_MODE_RESOLUTION:-} ]] && { echo "$CREATOR_MODE_RESOLUTION"; return; }
  local width height
  read -r width height < <(hyprctl monitors -j 2>/dev/null | jq -r --arg name "$1" '.[] | select(.name == $name) | "\(.width) \(.height)"')
  if [[ ${width:-0} =~ ^[0-9]+$ && ${height:-0} =~ ^[0-9]+$ ]] && ((width > 3840 || height > 2160)); then
    echo "3840x2160"
  else
    echo "0x0"
  fi
}

file_duration() {
  ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$1" 2>/dev/null | head -n1
}

cmd_check() {
  local missing dir
  missing=$(missing_deps)
  if [[ -n $missing ]]; then
    local pkgs=() dep
    for dep in $missing; do pkgs+=("$(package_for "$dep")"); done
    fail "missing_dependency" "Missing: $missing. Install with: sudo pacman -S ${pkgs[*]}"
  fi
  dir=$(ensure_output_dir) || exit 1
  printf '{"ok":true,"outputDir":%s,"recorder":%s,"studio":%s,"webcam":%s}\n' "$(json_str "$dir")" "$(json_str "$RECORDER")" \
    "$(studio_available && echo true || echo false)" "$(webcam_available && echo true || echo false)"
}

cmd_status() {
  if ! load_state; then
    PID=""
    if foreign_recorder_running; then
      printf '{"ok":true,"state":"idle","foreignRecording":true}\n'
    else
      printf '{"ok":true,"state":"idle","foreignRecording":false}\n'
    fi
    return
  fi
  if is_ours_alive; then
    printf '{"ok":true,"state":"recording","pid":%s,"file":%s,"startedAt":%s}\n' "$PID" "$(json_str "$FILE")" "${STARTED:-0}"
  else
    printf '{"ok":true,"state":"crashed","file":%s,"startedAt":%s,"log":%s}\n' "$(json_str "$FILE")" "${STARTED:-0}" "$(json_str "$(log_tail)")"
  fi
}

# Same selection flow and output mapping as omarchy-capture-screenrecording:
# a pick matching a whole monitor records that monitor, anything else records
# the region in logical coordinates (gpu-screen-recorder scales it itself).
cmd_pick() {
  command -v "$PICKER" >/dev/null 2>&1 || fail "missing_dependency" "Missing: $PICKER (ships with Omarchy)."
  local selection
  selection=$("$PICKER" smart --match-monitor 2>/dev/null) || fail "cancelled" "Selection cancelled"
  selection=$(tail -n1 <<<"$selection")

  if [[ $selection =~ ^monitor:([A-Za-z0-9._-]+)$ ]]; then
    printf '{"ok":true,"target":%s,"label":%s}\n' "$(json_str "$selection")" "$(json_str "Monitor ${BASH_REMATCH[1]}")"
  elif [[ $selection =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
    local w=${BASH_REMATCH[3]} h=${BASH_REMATCH[4]}
    ((w >= 2 && h >= 2)) || fail "cancelled" "Selection too small"
    printf '{"ok":true,"target":%s,"label":%s}\n' \
      "$(json_str "region:${w}x${h}+${BASH_REMATCH[1]}+${BASH_REMATCH[2]}")" "$(json_str "Area ${w}×${h}")"
  else
    fail "cancelled" "Selection cancelled"
  fi
}

cmd_start() {
  local audio="none" target="focused" studio="off" webcam="off" arg
  for arg in "$@"; do
    case $arg in
    --audio=*) audio=${arg#*=} ;;
    --target=*) target=${arg#*=} ;;
    --studio=*) studio=${arg#*=} ;;
    --webcam=*) webcam=${arg#*=} ;;
    *) fail "usage" "Unknown option: $arg" ;;
    esac
  done
  case $audio in none | desktop | desktop+mic) ;; *) fail "usage" "Unknown audio mode: $audio" ;; esac
  case $studio in on | off) ;; *) fail "usage" "Unknown studio mode: $studio" ;; esac
  case $webcam in on | off) ;; *) fail "usage" "Unknown webcam mode: $webcam" ;; esac
  [[ $target == "focused" || $target =~ ^monitor:[A-Za-z0-9._-]+$ || $target =~ ^region:[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+$ ]] ||
    fail "usage" "Unknown capture target: $target"

  require_deps
  with_lock

  if load_state; then
    if is_ours_alive; then
      fail "already_recording" "Creator Mode is already recording." ",\"file\":$(json_str "$FILE")"
    fi
    restore_cursor
    rm -f "$STATE_FILE"
  fi
  PID=""
  if foreign_recorder_running; then
    fail "foreign_recording" "Another screen recording is already running (started outside Creator Mode). Stop it first, e.g. with Alt+Print."
  fi

  local dir monitor file stamp n=1 capture_args=()
  dir=$(ensure_output_dir) || exit 1
  case $target in
  region:*)
    capture_args=(-w "${target#region:}")
    [[ -n ${CREATOR_MODE_RESOLUTION:-} ]] && capture_args+=(-s "$CREATOR_MODE_RESOLUTION")
    ;;
  *)
    if [[ $target == monitor:* ]]; then
      monitor=${target#monitor:}
    else
      monitor=$(focused_monitor)
      [[ -n $monitor ]] || fail "no_monitor" "Couldn't find the focused monitor (hyprctl monitors returned nothing)."
    fi
    capture_args=(-w "$monitor" -s "$(capture_size "$monitor")")
    ;;
  esac

  stamp=$(date +'%Y-%m-%d_%H-%M-%S')
  file="$dir/creator-mode-$stamp.mp4"
  while [[ -e $file ]]; do
    n=$((n + 1))
    file="$dir/creator-mode-$stamp-$n.mp4"
  done

  local audio_args=()
  case $audio in
  desktop) audio_args=(-a "default_output" -ac aac) ;;
  desktop+mic) audio_args=(-a "default_output|default_input" -ac aac) ;;
  esac

  # Studio: start the tracker first so the real cursor is only hidden once
  # something is logging it; any tracker problem degrades to a plain recording.
  local tracker_pid="" events="" studio_note="" cursor_args=()
  if [[ $studio == "on" ]]; then
    local region monitor_target=$target
    [[ $target == "focused" ]] && monitor_target="monitor:$monitor"
    region=$(logical_region "$monitor_target")
    if ! studio_available; then
      studio_note="Studio needs python3 and ffmpeg; recording without it."
    elif [[ ! $region =~ ^-?[0-9]+,-?[0-9]+,[0-9]+,[0-9]+$ ]]; then
      studio_note="Couldn't work out the capture area; recording without studio tracking."
    elif ! mkdir -p "$dir/.creator-mode" 2>/dev/null; then
      studio_note="Can't write $dir/.creator-mode; recording without studio tracking."
    else
      events="$dir/.creator-mode/$(basename "${file%.mp4}").events.jsonl"
      : >"$TRACKER_LOG"
      setsid python3 "$TRACKER" --out "$events" --region "$region" </dev/null >>"$TRACKER_LOG" 2>&1 9>&- &
      tracker_pid=$!
      sleep 0.3
      if ! kill -0 "$tracker_pid" 2>/dev/null; then
        studio_note="Cursor tracking failed: $(tail -n1 "$TRACKER_LOG" | cut -c1-200)"
        tracker_pid="" events=""
      else
        recorder_can_hide_cursor && cursor_args=(-cursor no)
        grep -q '"input": "none"' "$events" 2>/dev/null &&
          studio_note="Clicks aren't readable (add yourself to the input group); zooms follow where the cursor rests."
      fi
    fi
  fi

  # Studio also keeps desktop and mic as separate tracks (after the mixed one
  # players use) so the editor can balance them.
  local audio_tracks=""
  if [[ $studio == "on" && $audio == "desktop+mic" ]] && studio_available && mkdir -p "$dir/.creator-mode" 2>/dev/null; then
    audio_args=(-a "default_output|default_input" -a "default_output" -a "default_input" -ac aac)
    audio_tracks='"mix","system","mic"'
  elif [[ $audio != none ]]; then
    audio_tracks='"mix"'
  fi

  local webcam_pid="" webcam_file="" webcam_start=""
  if [[ $webcam == "on" ]]; then
    if [[ $studio != "on" ]] || ! studio_available; then
      studio_note="${studio_note:+$studio_note }The webcam bubble needs Studio on."
    elif ! webcam_available; then
      studio_note="${studio_note:+$studio_note }No webcam found at $WEBCAM_DEVICE."
    elif mkdir -p "$dir/.creator-mode" 2>/dev/null; then
      webcam_file="$dir/.creator-mode/$(basename "${file%.mp4}").webcam.mkv"
      : >"$WEBCAM_LOG"
      setsid ffmpeg -hide_banner -loglevel error -nostdin -f "$WEBCAM_FORMAT" -i "$WEBCAM_DEVICE" -an \
        -c:v libx264 -preset ultrafast -crf 23 -g 60 -y "$webcam_file" </dev/null >>"$WEBCAM_LOG" 2>&1 9>&- &
      webcam_pid=$!
      local waited=0
      while kill -0 "$webcam_pid" 2>/dev/null && [[ ! -s $webcam_file ]] && ((waited < 50)); do
        sleep 0.02
        waited=$((waited + 1))
      done
      webcam_start=${EPOCHREALTIME/,/.}
      sleep 0.1
      if ! kill -0 "$webcam_pid" 2>/dev/null; then
        studio_note="${studio_note:+$studio_note }Webcam failed: $(tail -n1 "$WEBCAM_LOG" | cut -c1-160)"
        webcam_pid="" webcam_file=""
      fi
    fi
  fi
  : >"$LOG_FILE"
  [[ -n $tracker_pid ]] && hide_cursor
  # setsid detaches the recorder from the shell process so restarting
  # omarchy-shell (or closing the panel) never interrupts a recording; 9>&- keeps
  # the long-lived recorder from inheriting (and holding) the control lock, and
  # --default-signal undoes the SIGINT-ignore bash applies to background jobs.
  setsid env --default-signal=INT "$RECORDER" "${capture_args[@]}" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes \
    "${cursor_args[@]}" -o "$file" "${audio_args[@]}" </dev/null >>"$LOG_FILE" 2>&1 9>&- &
  local pid=$!

  local deadline=$((EPOCHSECONDS + START_TIMEOUT))
  while kill -0 "$pid" 2>/dev/null && [[ ! -s $file ]] && ((EPOCHSECONDS < deadline)); do
    sleep 0.02
  done
  # When the recorder first writes is the best wall-clock anchor for frame 0;
  # the renderer lines the cursor log and webcam up against it.
  local rec_start=${EPOCHREALTIME/,/.}
  if [[ $studio == "on" && -d $dir/.creator-mode ]]; then
    printf '{"audio":[%s],"webcam":%s,"recStart":%s,"webcamStart":%s}\n' "$audio_tracks" \
      "$([[ -n $webcam_file ]] && json_str "$(basename "$webcam_file")" || echo null)" \
      "$rec_start" "${webcam_start:-null}" \
      >"$dir/.creator-mode/$(basename "${file%.mp4}").session.json"
  fi

  TRACKER_PID=$tracker_pid EVENTS=$events WEBCAM_PID=$webcam_pid WEBCAM=$webcam_file
  local session
  session="$dir/.creator-mode/$(basename "${file%.mp4}").session.json"
  if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" 2>/dev/null
    local code=$?
    stop_tracker
    stop_webcam
    restore_cursor
    rm -f "$session" ${webcam_file:+"$webcam_file"}
    [[ -n $events ]] && rm -f "$events"
    rm -f "$file"
    local detail
    detail=$(log_tail)
    fail "recorder_failed" "The recorder exited before recording started (exit $code).${detail:+ $detail}" ",\"log\":$(json_str "$LOG_FILE")"
  fi

  if [[ ! -s $file ]]; then
    kill -INT "$pid" 2>/dev/null
    sleep 1
    kill -KILL "$pid" 2>/dev/null
    stop_tracker
    stop_webcam
    restore_cursor
    rm -f "$session" ${webcam_file:+"$webcam_file"}
    [[ -n $events ]] && rm -f "$events"
    rm -f "$file"
    fail "start_timeout" "The recorder didn't start writing within ${START_TIMEOUT}s." ",\"log\":$(json_str "$LOG_FILE")"
  fi

  local started
  started=$(now_ms)
  printf 'pid=%s\nfile=%s\nstarted=%s\naudio=%s\ntarget=%s\ntracker_pid=%s\nevents=%s\nwebcam_pid=%s\nwebcam=%s\ncursor_theme=%s\ncursor_size=%s\n' \
    "$pid" "$file" "$started" "$audio" "$target" "$tracker_pid" "$events" "$webcam_pid" "$webcam_file" \
    "$CURSOR_THEME" "$CURSOR_SIZE" >"$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"
  refresh_omarchy_indicator

  printf '{"ok":true,"state":"recording","pid":%s,"file":%s,"startedAt":%s,"studio":%s,"webcam":%s,"notice":%s}\n' \
    "$pid" "$(json_str "$file")" "$started" "$([[ -n $events ]] && echo true || echo false)" \
    "$([[ -n $webcam_file ]] && echo true || echo false)" "$(json_str "$studio_note")"
}

cmd_stop() {
  with_lock
  load_state || fail "not_recording" "Creator Mode isn't recording."

  if is_ours_alive; then
    kill -INT "$PID" 2>/dev/null
    restore_cursor
    stop_tracker
    stop_webcam
    local waited=0 limit=$((STOP_TIMEOUT * 10))
    while is_ours_alive && ((waited < limit)); do
      sleep 0.1
      waited=$((waited + 1))
    done
    if is_ours_alive; then
      kill -KILL "$PID" 2>/dev/null
      stop_tracker
      stop_webcam
      rm -f "$STATE_FILE"
      refresh_omarchy_indicator
      fail "save_timeout" "The recorder didn't finish saving within ${STOP_TIMEOUT}s and was force-stopped. The file may be incomplete." ",\"file\":$(json_str "$FILE")"
    fi
    CRASHED=false
  else
    CRASHED=true
  fi
  stop_tracker
  stop_webcam
  restore_cursor

  rm -f "$STATE_FILE"
  refresh_omarchy_indicator

  if [[ ! -s $FILE ]]; then
    fail "no_output" "No video was saved. The recorder stopped without writing $FILE." ",\"log\":$(json_str "$LOG_FILE")"
  fi

  local duration size
  duration=$(file_duration "$FILE")
  if [[ ! $duration =~ ^[0-9.]+$ ]]; then
    fail "invalid_output" "The saved file can't be read as a video: $FILE" ",\"file\":$(json_str "$FILE"),\"log\":$(json_str "$LOG_FILE")"
  fi
  size=$(stat -c %s "$FILE")

  local events_json=null webcam_json=null
  [[ -n $EVENTS && -s $EVENTS ]] && events_json=$(json_str "$EVENTS")
  [[ -n $WEBCAM && -s $WEBCAM ]] && webcam_json=$(json_str "$WEBCAM")

  printf '{"ok":true,"state":"saved","file":%s,"dir":%s,"duration":%s,"size":%s,"recovered":%s,"events":%s,"webcam":%s}\n' \
    "$(json_str "$FILE")" "$(json_str "$(dirname "$FILE")")" "$duration" "$size" "$CRASHED" "$events_json" "$webcam_json"
}

# Progress lines are passed through from creator-mode-studio; the last line is
# the result. The raw recording is never modified.
cmd_render() {
  local file="" background="theme" zoom="1.8" arg
  local -a extra=()
  for arg in "$@"; do
    case $arg in
    --background=*) background=${arg#*=} ;;
    --zoom=*) zoom=${arg#*=} ;;
    --format=* | --quality=* | --export=* | --layout=* | --inset=* | --shadow=* | --padding=*) extra+=("$arg") ;;
    -*) fail "usage" "Unknown option: $arg" ;;
    *) [[ -z $file ]] || fail "usage" "render takes one file"; file=$arg ;;
    esac
  done
  [[ -n $file ]] || fail "usage" "render needs a file path"
  [[ -f $file ]] || fail "not_found" "Recording no longer exists: $file"
  [[ $zoom =~ ^[0-9]+(\.[0-9]+)?$ ]] || fail "usage" "Zoom must be a number: $zoom"
  studio_available || fail "missing_dependency" "Studio needs python3 and ffmpeg. Install with: sudo pacman -S python ffmpeg"
  exec python3 "$STUDIO" render "$file" --background="$background" --zoom="$zoom" "${extra[@]}" --json-progress 9>&-
}

# Starts the editor detached (it outlives the panel) and returns its URL.
cmd_edit() {
  local file=${1:-} out line
  [[ -n $file ]] || fail "usage" "edit needs a file path"
  [[ -f $file ]] || fail "not_found" "Recording no longer exists: $file"
  studio_available && [[ -x $EDITOR_BIN ]] || fail "missing_dependency" "The editor needs python3 and ffmpeg. Install with: sudo pacman -S python ffmpeg"
  mkdir -p "$STATE_DIR" || fail "state_dir" "Can't create $STATE_DIR"
  out="$STATE_DIR/editor.out"
  : >"$out"
  setsid python3 "$EDITOR_BIN" "$file" ${CREATOR_MODE_EDITOR_NO_OPEN:+--no-open} </dev/null >"$out" 2>&1 9>&- &
  for _ in $(seq 150); do
    line=$(head -n1 "$out")
    [[ -n $line ]] && break
    sleep 0.1
  done
  [[ $line == "{"* ]] || fail "editor_failed" "The editor didn't start: ${line:-no output}"
  printf '%s\n' "$line"
}

cmd_reveal() {
  local file=${1:-} dir
  [[ -n $file ]] || fail "usage" "reveal needs a file path"
  dir=$(dirname "$file")
  [[ -d $dir ]] || fail "not_found" "Folder no longer exists: $dir"

  local launcher=()
  command -v uwsm-app >/dev/null 2>&1 && launcher=(uwsm-app --)

  if command -v nautilus >/dev/null 2>&1 && [[ -f $file ]]; then
    setsid "${launcher[@]}" nautilus --new-window --select "$file" </dev/null >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then
    setsid "${launcher[@]}" xdg-open "$dir" </dev/null >/dev/null 2>&1 &
  else
    fail "missing_dependency" "No file manager found (install nautilus or xdg-utils)."
  fi
  printf '{"ok":true,"dir":%s}\n' "$(json_str "$dir")"
}

case ${1:-} in
check) cmd_check ;;
status) cmd_status ;;
pick) cmd_pick ;;
start) shift; cmd_start "$@" ;;
stop) cmd_stop ;;
render) shift; cmd_render "$@" ;;
edit) shift; cmd_edit "$@" ;;
reveal) shift; cmd_reveal "$@" ;;
*) fail "usage" "Usage: creator-mode-rec check|status|pick|start [--audio=none|desktop|desktop+mic] [--target=focused|monitor:NAME|region:WxH+X+Y] [--studio=on|off] [--webcam=on|off]|stop|render <file> [--background=BG] [--zoom=N] [--format=F] [--quality=Q] [--export=mp4|gif]|edit <file>|reveal <file>" ;;
esac
